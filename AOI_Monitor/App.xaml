<Application x:Class="AOI_Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="Bg"        Color="#0B0E10"/>
    <SolidColorBrush x:Key="WindowBg"  Color="#121619"/>
    <SolidColorBrush x:Key="FrameBg"   Color="#252C31"/>
    <SolidColorBrush x:Key="Frame2Bg"  Color="#1B2024"/>
    <SolidColorBrush x:Key="CellBg"    Color="#151A1E"/>
    <SolidColorBrush x:Key="Cell2Bg"   Color="#1C2328"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3D464D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D8DEE3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B969E"/>
    <SolidColorBrush x:Key="DimBrush" Color="#667078"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#50F56E"/>
    <SolidColorBrush x:Key="RedBrush" Color="#F13B3F"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#E1A334"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#5CA0D3"/>

    <!-- ═══ FONTS ═══ -->
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- ═══ BASE TEXTBLOCK ═══ -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- ═══ BUTTON (dark base) ═══ -->
    <Style TargetType="Button">
      <Setter Property="Background"    Value="#1A2126"/>
      <Setter Property="BorderBrush"   Value="#4B5660"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="#D2D9DE"/>
      <Setter Property="Padding"       Value="8,2"/>
      <Setter Property="MinHeight"     Value="22"/>
      <Setter Property="FontFamily"    Value="Segoe UI"/>
      <Setter Property="FontSize"      Value="11"/>
      <Setter Property="Cursor"        Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1D2830"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#5B6670"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#252F38"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Mini buttons -->
    <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="10.5"/><Setter Property="MinHeight" Value="22"/><Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style x:Key="MiniBtnGreen" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#3C7F4D"/><Setter Property="Background" Value="#14351D"/><Setter Property="Foreground" Value="#C1FFCB"/>
    </Style>
    <Style x:Key="MiniBtnAmber" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#806434"/><Setter Property="Background" Value="#332715"/><Setter Property="Foreground" Value="#FFE0A4"/>
    </Style>
    <Style x:Key="MiniBtnRed" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
      <Setter Property="BorderBrush" Value="#854041"/><Setter Property="Background" Value="#351719"/><Setter Property="Foreground" Value="#FFBCBC"/>
    </Style>

    <!-- Action buttons -->
    <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="BorderBrush" Value="#5A646D"/><Setter Property="Background" Value="#222A30"/><Setter Property="Foreground" Value="#E8EEF2"/>
    </Style>
    <Style x:Key="ActionBtnGreen" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#3C8D50"/><Setter Property="Background" Value="#17391F"/><Setter Property="Foreground" Value="#D1FFD8"/>
    </Style>
    <Style x:Key="ActionBtnRed" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#A13A3F"/><Setter Property="Background" Value="#4A171A"/><Setter Property="Foreground" Value="#FFD0D2"/>
    </Style>
    <Style x:Key="ActionBtnAmber" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#987538"/><Setter Property="Background" Value="#3F2C13"/><Setter Property="Foreground" Value="#FFE3AD"/>
    </Style>
    <Style x:Key="ActionBtnBlue" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
      <Setter Property="BorderBrush" Value="#4B87B4"/><Setter Property="Background" Value="#173047"/><Setter Property="Foreground" Value="#CFEAFF"/>
    </Style>

    <!-- Nav button -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background"    Value="#171D21"/>
      <Setter Property="BorderBrush"   Value="#374047"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="#C9D1D6"/>
      <Setter Property="MinHeight"     Value="44"/>
      <Setter Property="Margin"        Value="0,0,0,6"/>
      <Setter Property="Padding"       Value="0"/>
      <Setter Property="Cursor"        Value="Hand"/>
      <Setter Property="FontFamily"    Value="Segoe UI"/>
      <Setter Property="FontSize"      Value="12"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1D252A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#5B6670"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ TEXTBOX ═══ -->
    <Style TargetType="TextBox">
      <Setter Property="Background"    Value="#0F1316"/>
      <Setter Property="BorderBrush"   Value="#4A535C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="#E7EDF2"/>
      <Setter Property="CaretBrush"    Value="#D8DEE3"/>
      <Setter Property="SelectionBrush" Value="#5CA0D3"/>
      <Setter Property="MinHeight"     Value="28"/>
      <Setter Property="Padding"       Value="6,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily"    Value="Segoe UI"/>
      <Setter Property="FontSize"      Value="13"/>
    </Style>
    <Style x:Key="ReadonlyInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Foreground"  Value="#99A4AB"/>
      <Setter Property="Background"  Value="#101417"/>
      <Setter Property="IsReadOnly"  Value="True"/>
    </Style>

    <!-- ═══ COMBOBOX ═══ -->
    <Style TargetType="ComboBox">
      <Setter Property="Background"    Value="#0F1316"/>
      <Setter Property="BorderBrush"   Value="#4A535C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"    Value="#E7EDF2"/>
      <Setter Property="MinHeight"     Value="28"/>
      <Setter Property="Padding"       Value="6,3"/>
      <Setter Property="FontFamily"    Value="Segoe UI"/>
      <Setter Property="FontSize"      Value="13"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#0F1316"/>
      <Setter Property="Foreground" Value="#E7EDF2"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#1D2830"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ═══ DATAGRID ═══ -->
    <Style TargetType="DataGrid">
      <Setter Property="Background"              Value="#151A1E"/>
      <Setter Property="BorderBrush"             Value="#343D44"/>
      <Setter Property="BorderThickness"         Value="1"/>
      <Setter Property="Foreground"              Value="#C3CCD3"/>
      <Setter Property="FontFamily"              Value="Segoe UI"/>
      <Setter Property="FontSize"                Value="11"/>
      <Setter Property="RowBackground"           Value="#151A1E"/>
      <Setter Property="AlternatingRowBackground" Value="#171D21"/>
      <Setter Property="GridLinesVisibility"     Value="All"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#343D44"/>
      <Setter Property="VerticalGridLinesBrush"  Value="#343D44"/>
      <Setter Property="HeadersVisibility"       Value="Column"/>
      <Setter Property="AutoGenerateColumns"     Value="False"/>
      <Setter Property="CanUserAddRows"          Value="False"/>
      <Setter Property="CanUserDeleteRows"       Value="False"/>
      <Setter Property="CanUserReorderColumns"   Value="False"/>
      <Setter Property="IsReadOnly"              Value="True"/>
      <Setter Property="SelectionMode"           Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"    Value="#222A30"/>
      <Setter Property="Foreground"    Value="#C9D2D8"/>
      <Setter Property="FontWeight"    Value="ExtraBold"/>
      <Setter Property="FontSize"      Value="10.5"/>
      <Setter Property="Padding"       Value="6,5"/>
      <Setter Property="BorderBrush"   Value="#343D44"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="SeparatorBrush" Value="#343D44"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#273642"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1C2530"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush"   Value="#343D44"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Padding"       Value="5,4"/>
      <Setter Property="Background"    Value="Transparent"/>
      <Setter Property="Foreground"    Value="#C3CCD3"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#273642"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ═══ PROGRESSBAR (dark bar track) ═══ -->
    <Style x:Key="BarTrack" TargetType="ProgressBar">
      <Setter Property="Height"     Value="8"/>
      <Setter Property="Foreground" Value="#7896C0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="#262D32" BorderBrush="#343C42" BorderThickness="1">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarTrackRed" TargetType="ProgressBar" BasedOn="{StaticResource BarTrack}">
      <Setter Property="Foreground" Value="#C34141"/>
    </Style>
    <Style x:Key="BarTrackAmber" TargetType="ProgressBar" BasedOn="{StaticResource BarTrack}">
      <Setter Property="Foreground" Value="#C58B31"/>
    </Style>

    <!-- ═══ SCROLLBAR (dark thin) ═══ -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#0F1316"/>
    </Style>

    <!-- ═══ CHIP badge borders ═══ -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background"    Value="#20282E"/>
      <Setter Property="BorderBrush"   Value="#51606B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"       Value="6,2"/>
    </Style>
    <Style x:Key="ChipRed" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#35191B"/><Setter Property="BorderBrush" Value="#9A393E"/>
    </Style>
    <Style x:Key="ChipGreen" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#14311D"/><Setter Property="BorderBrush" Value="#377849"/>
    </Style>
    <Style x:Key="ChipAmber" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#372914"/><Setter Property="BorderBrush" Value="#8C6C35"/>
    </Style>
    <Style x:Key="ChipBlue" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="#172A39"/><Setter Property="BorderBrush" Value="#477CA5"/>
    </Style>

    <!-- ═══ FIELD BOX ═══ -->
    <Style x:Key="FieldBox" TargetType="Border">
      <Setter Property="Background"    Value="#151B1F"/>
      <Setter Property="BorderBrush"   Value="#3A444B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"       Value="6"/>
    </Style>

    <!-- ═══ PANEL container ═══ -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background"    Value="#151A1E"/>
      <Setter Property="BorderBrush"   Value="#3E474E"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

  </Application.Resources>
</Application>
