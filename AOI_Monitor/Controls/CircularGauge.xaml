<UserControl x:Class="AOI_Monitor.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="76" Height="76">
  <Grid x:Name="Root" ClipToBounds="True">
    <!-- Background track -->
    <Path x:Name="TrackPath" StrokeThickness="12" Stroke="#363D42" Fill="Transparent"/>
    <!-- Value arc -->
    <Path x:Name="ArcPath"   StrokeThickness="12" Fill="Transparent"
          StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
    <!-- Inner mask -->
    <Ellipse x:Name="InnerMask" Width="52" Height="52" Fill="#121619"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <!-- Value label -->
    <TextBlock x:Name="ValueText"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center"
               FontSize="11" FontWeight="Bold" Foreground="#DCE5EB"/>
  </Grid>
</UserControl>
