<Window x:Class="AOI_Monitor.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AOI Image Viewer"
        Width="1500"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0D2438" BorderBrush="#2E3D47" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="10,6,10,4" LastChildFill="True">
            <Button x:Name="CloseViewerButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MiniBtn}"
                    Content="Close"
                    Margin="8,0,0,0"
                    Click="OnCloseClick"/>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ViewerTitleText"
                         Text="AOI Image Viewer"
                         Foreground="#F7FAFC"
                         FontSize="16"
                         FontWeight="ExtraBold"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="520"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                         Margin="0,0,10,0"/>
              <Border Background="#2A1740" BorderBrush="#8F5FD1" BorderThickness="1" Padding="8,3" Margin="0,0,8,0">
                <TextBlock x:Name="ViewerBoundaryText"
                           Text="Snapshot view / prototype evidence"
                           Foreground="#F1D8FF"
                           FontSize="14"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="260"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </Border>
              <Border Background="#141D24" BorderBrush="#3A4A55" BorderThickness="1" Padding="8,3">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Critical " Foreground="#AAB4BB" FontSize="14"/>
                  <TextBlock x:Name="ViewerCriticalText"
                             Text="none"
                             Foreground="#DCE5EB"
                             FontSize="14"
                             FontWeight="ExtraBold"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="220"
                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </StackPanel>
              </Border>
            </WrapPanel>
          </DockPanel>

          <WrapPanel Grid.Row="1" Margin="10,0,10,8">
            <Button x:Name="FitImageButton" Style="{StaticResource MiniBtn}" Content="Fit" Margin="0,0,6,0" Click="OnFitClick"/>
            <Button x:Name="ActualSizeButton" Style="{StaticResource MiniBtn}" Content="100%" Margin="0,0,6,0" Click="OnActualSizeClick"/>
            <Button x:Name="ZoomOutButton" Style="{StaticResource MiniBtn}" Content="Zoom -" Margin="0,0,6,0" Click="OnZoomOutClick"/>
            <Button x:Name="ZoomInButton" Style="{StaticResource MiniBtn}" Content="Zoom +" Margin="0,0,6,0" Click="OnZoomInClick"/>
            <Button x:Name="SaveImageButton" Style="{StaticResource ActionBtnBlue}" Content="Save PNG" Margin="8,0,0,0" Click="OnSaveClick"/>
          </WrapPanel>
        </Grid>
      </Border>

      <ScrollViewer x:Name="ViewerScrollHost"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="#050607"
                    CanContentScroll="False">
        <Grid x:Name="ImageViewportHost" Background="#050607">
          <Image x:Name="ViewerImage"
                 Stretch="None"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality">
            <Image.LayoutTransform>
              <ScaleTransform x:Name="ViewerScale" ScaleX="1" ScaleY="1"/>
            </Image.LayoutTransform>
          </Image>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#081018" BorderBrush="#2E3D47" BorderThickness="0,1,0,0" MinHeight="30">
        <DockPanel Margin="10,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="Size " Foreground="#8D99A1" FontSize="14"/>
            <TextBlock x:Name="ViewerImageSizeText" Text="--" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" Margin="0,0,14,0"/>
            <TextBlock Text="Zoom " Foreground="#8D99A1" FontSize="14"/>
            <TextBlock x:Name="ViewerZoomText" Text="100%" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14"/>
          </StackPanel>
          <TextBlock x:Name="ViewerMessageText"
                     Text="Pan with scroll bars. Save creates a PNG snapshot of this viewer source."
                     Foreground="#B9C4CC"
                     FontSize="14"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
