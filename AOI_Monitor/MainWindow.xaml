<Window x:Class="AOI_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AOI_Monitor.ViewModels"
        Title="PCBA AOI Installation Monitor"
        Width="1600" Height="940" MinWidth="1200" MinHeight="780"
        Background="#050607"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Border Background="#121619" BorderBrush="#505962" BorderThickness="1" Margin="4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.62" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30"/>  <!-- top clock bar -->
        <RowDefinition Height="36"/>  <!-- menu bar -->
        <RowDefinition Height="42"/>  <!-- status strip -->
        <RowDefinition Height="*"/>   <!-- content -->
        <RowDefinition Height="26"/>  <!-- footer -->
      </Grid.RowDefinitions>

      <!-- ══ ROW 0: Top clock bar ══ -->
      <Grid Grid.Row="0" Background="#0A0D0F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#32383D" BorderThickness="0,0,1,0">
          <TextBlock Text="{Binding ClockText}"
                     FontFamily="Consolas" FontSize="18" FontWeight="Normal"
                     Foreground="#E8EDF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Ellipse Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse.Fill>
              <RadialGradientBrush GradientOrigin="0.35,0.35">
                <GradientStop Color="#F33333" Offset="0.15"/>
                <GradientStop Color="#14301A" Offset="0.55"/>
                <GradientStop Color="#060708" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="PCBA AOI INSTALLATION MONITOR"
                     FontWeight="ExtraBold" Foreground="#E4E9EE" FontSize="13"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBlock Text="background inspection service / review console / traceability"
                     Foreground="#9BA6AD" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" BorderBrush="#252C31" BorderThickness="1,0,0,0">
          <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="Background Service" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="GUI Monitor" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="DB Connected" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Model Loaded" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ ROW 1: Menu bar ══ -->
      <Grid Grid.Row="1" Background="#161B1F">
        <Border BorderBrush="#343C43" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Border Width="88" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="File" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="88" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="Library" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="88" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="Inspection" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="88" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="Recipe" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="72" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="SPC" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="88" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="Reports" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="72" BorderBrush="#2D343A" BorderThickness="0,0,1,0">
                <TextBlock Text="Admin" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Width="72">
                <TextBlock Text="Help" Foreground="#BDC7CE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Border BorderBrush="#2D343A" BorderThickness="1,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Border Width="110" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Operator" Foreground="#AAB4BB" FontSize="11.5"/>
                      <TextBlock Text="Engineer01" FontWeight="SemiBold" Foreground="#E7ECEF" FontSize="11.5" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Width="90" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Shift" Foreground="#AAB4BB" FontSize="11.5"/>
                      <TextBlock Text="A" FontWeight="SemiBold" Foreground="#E7ECEF" FontSize="11.5" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Width="110" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Authority" Foreground="#AAB4BB" FontSize="11.5"/>
                      <TextBlock Text="Review" FontWeight="SemiBold" Foreground="#E7ECEF" FontSize="11.5" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Mode" Foreground="#AAB4BB" FontSize="11.5"/>
                      <TextBlock Text="Background Service" FontWeight="SemiBold" Foreground="#E7ECEF" FontSize="11.5" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ══ ROW 2: Status strip ══ -->
      <Grid Grid.Row="2" Background="#1B2024">
        <Border BorderBrush="#3C444B" BorderThickness="0,0,0,1">
          <UniformGrid Columns="6">
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Install Target" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock Text="Factory Station PC" Foreground="#F0F5F8" FontWeight="Bold" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Runtime Model" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock Text="Background Svc + GUI Mon." Foreground="#F0F5F8" FontWeight="Bold" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Board / Program" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock Text="TBOX-MAIN / TBOX_TOP_V1.2" Foreground="#50F56E" FontWeight="Bold" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Review Policy" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="ReviewPolicyText" Text="Minimize False Positives" Foreground="#E1A334" FontWeight="Bold" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="AI Model" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock Text="AOI_AI_0.8.1" Foreground="#F0F5F8" FontWeight="Bold" FontSize="13"/>
              </StackPanel>
            </Border>
            <Border Padding="10,6">
              <StackPanel>
                <TextBlock Text="Storage" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock Text="Local SQLite + Image Vault" Foreground="#F0F5F8" FontWeight="Bold" FontSize="12"/>
              </StackPanel>
            </Border>
          </UniformGrid>
        </Border>
      </Grid>

      <!-- ══ ROW 3: Main content ══ -->
      <Grid Grid.Row="3" Background="#0B0E10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#111518">
          <Border BorderBrush="#4A535C" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Station ID -->
              <Border Grid.Row="0" BorderBrush="#363F46" BorderThickness="0,0,0,1" Padding="8,10">
                <StackPanel>
                  <Border Background="#0B0E10" BorderBrush="#58616A" BorderThickness="1" Padding="8">
                    <TextBlock Text="AOI-LIB" FontSize="15" FontWeight="ExtraBold"
                               Foreground="#E8EDF2" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="installation console / background service"
                             Foreground="#87939B" FontSize="10" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Nav stack -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavPages}" Margin="8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Key}">
                        <Grid>
                          <!-- Active left accent -->
                          <Rectangle Width="3" HorizontalAlignment="Left" Fill="Transparent" x:Name="Accent"/>
                          <Grid Margin="3,5,8,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}"
                                       FontFamily="Consolas" FontSize="10.5"
                                       Foreground="#9EADB7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                         FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              <TextBlock Text="{Binding Subtitle}"
                                         FontSize="9.5" Foreground="#7F8C95" Margin="0,2,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Grid>
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#25313A"/>
                                <Setter Property="BorderBrush" Value="#82A8C2"/>
                                <Setter Property="Foreground"  Value="#F5F9FB"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Alarm panel -->
              <Border Grid.Row="2" Background="#0C0F11" BorderBrush="#3A4249" BorderThickness="0,1,0,0" Padding="8">
                <StackPanel>
                  <TextBlock Text="ACTIVE MESSAGE" Foreground="#F0A0A0" FontWeight="ExtraBold" FontSize="10.5" Margin="0,0,0,5"/>
                  <TextBlock Text="Background inspection service remains active." Foreground="#ED6262" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock Text="GUI is monitor/review console, not the core runtime engine."
                             Foreground="#ED6262" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Main panel -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Page title bar -->
          <Grid Grid.Row="0" Background="#0F1316" x:Name="PageTitleBar">
            <Border BorderBrush="#30383F" BorderThickness="0,0,0,1">
              <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Border Background="#172027" BorderBrush="#34414A" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Sample " Foreground="#8FA0AB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowSampleText" Text="none" Foreground="#DCE5EB" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#172027" BorderBrush="#34414A" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Golden " Foreground="#8FA0AB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowGoldenText" Text="none" Foreground="#DCE5EB" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#1A2430" BorderBrush="#3B5B77" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Score " Foreground="#9AB1C4" FontSize="10"/>
                      <TextBlock x:Name="WorkflowScoreText" Text="--" Foreground="#CFEAFF" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="WorkflowVerdictBorder" Background="#2A2E31" BorderBrush="#555E66" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Verdict " Foreground="#AAB4BB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowVerdictText" Text="REVIEW" Foreground="#DCE5EB" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Button Style="{StaticResource MiniBtn}" Content="Refresh" Margin="0,0,6,0" Click="OnRefreshClick"/>
                  <Button Style="{StaticResource MiniBtnAmber}" Content="Lock Recipe" Margin="0,0,6,0" Click="OnLockRecipeClick"/>
                  <Button Style="{StaticResource MiniBtnGreen}" Content="Export" Click="OnExportClick"/>
                </StackPanel>
                <TextBlock x:Name="PageTitleText"
                           Foreground="#E8EDF2" FontWeight="ExtraBold" FontSize="12.5"
                           VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Page content (swapped by code-behind) -->
          <ContentControl Grid.Row="1" x:Name="PageContent"/>
        </Grid>
      </Grid>

      <!-- ══ ROW 4: Footer ══ -->
      <Grid Grid.Row="4" Background="#0A0D0F">
        <Border BorderBrush="#374047" BorderThickness="0,1,0,0">
          <DockPanel Margin="8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="Station " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="AOI-LIB-01" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="Index " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="READY" FontWeight="Bold" Foreground="#50F56E" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Last Backup " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="08:30" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="REC " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="23,932" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="IMG LINK " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="23,711" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DB REV " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock Text="2026.01.28.1840" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

    </Grid>
  </Border>
</Window>
