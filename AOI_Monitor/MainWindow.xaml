<Window x:Class="AOI_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AOI_Monitor.ViewModels"
        Title="PCBA AOI Review Console"
        Width="1600" Height="940" MinWidth="1200" MinHeight="780"
        Background="#050607"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Border Background="#121619" BorderBrush="#505962" BorderThickness="1" Margin="4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.62" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30"/>  <!-- top clock bar -->
        <RowDefinition Height="36"/>  <!-- menu bar -->
        <RowDefinition Height="Auto"/>  <!-- status strip -->
        <RowDefinition Height="*"/>   <!-- content -->
        <RowDefinition Height="26"/>  <!-- footer -->
      </Grid.RowDefinitions>

      <!-- â•â• ROW 0: Top clock bar â•â• -->
      <Grid Grid.Row="0" Background="#0A0D0F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#32383D" BorderThickness="0,0,1,0">
          <TextBlock Text="{Binding ClockText}"
                     FontFamily="Consolas" FontSize="18" FontWeight="Normal"
                     Foreground="#E8EDF2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Ellipse Width="18" Height="18" VerticalAlignment="Center">
            <Ellipse.Fill>
              <RadialGradientBrush GradientOrigin="0.35,0.35">
                <GradientStop Color="#F33333" Offset="0.15"/>
                <GradientStop Color="#14301A" Offset="0.55"/>
                <GradientStop Color="#060708" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="PCBA AOI REVIEW CONSOLE"
                     FontWeight="ExtraBold" Foreground="#E4E9EE" FontSize="13"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBlock Text="local inspection review / recipe editor / log export"
                     Foreground="#9BA6AD" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <Border x:Name="OperatingModeBanner" Background="#372914" BorderBrush="#8C6C35" BorderThickness="1" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="OperatingModeBannerText" Text="Demo Mode" Foreground="#FFE0A7" FontSize="10.5" FontWeight="ExtraBold"/>
          </Border>
        </StackPanel>
        <Border Grid.Column="2" BorderBrush="#252C31" BorderThickness="1,0,0,0">
          <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="Local Engine" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Review UI" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="DB Status" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                <Ellipse.Fill><SolidColorBrush Color="#50F56E"/></Ellipse.Fill>
              </Ellipse>
              <TextBlock x:Name="HeaderEngineText" Text="Pixel Difference Prototype Engine" Foreground="#A8B2B9" FontSize="11.5"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- â•â• ROW 1: Menu bar â•â• -->
      <Grid Grid.Row="1" Background="#161B1F">
        <Border BorderBrush="#343C43" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button x:Name="FileMenuBtn" Style="{StaticResource MiniBtn}" Width="64" Margin="4,4,0,4" Content="File" Click="OnMenuFileClick"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Border BorderBrush="#2D343A" BorderThickness="1,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Border Width="220" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Operator" Foreground="#AAB4BB" FontSize="11.5" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" x:Name="UserIdText" Text="Engineer01" MinHeight="24" FontSize="11.5" Margin="6,0,0,0"/>
                    </Grid>
                  </Border>
                  <Border Width="100" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Shift" Foreground="#AAB4BB" FontSize="11.5" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="A" FontWeight="SemiBold" Foreground="#E7ECEF" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                  </Border>
                  <Border Width="180" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Demo Role" Foreground="#E1A334" FontSize="11.5" VerticalAlignment="Center" ToolTip="DemoLocalRoleSelector mode only. LocalUsers mode authenticates against local hashed users."/>
                      <ComboBox Grid.Column="1" x:Name="RoleCombo" SelectedIndex="0" MinHeight="24" Margin="4,0,0,0" SelectionChanged="OnRoleSelectionChanged">
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="Engineer"/>
                        <ComboBoxItem Content="Admin"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Width="238" BorderBrush="#2D343A" BorderThickness="0,0,1,0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Auth" Foreground="#AAB4BB" FontSize="11.5" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="AuthModeCombo" SelectedIndex="0" MinHeight="24" Margin="4,0,0,0" SelectionChanged="OnAuthModeSelectionChanged">
                        <ComboBoxItem Content="DemoLocalRoleSelector"/>
                        <ComboBoxItem Content="LocalUsers"/>
                        <ComboBoxItem Content="MesAuthenticationBoundary"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Width="406" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="52"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Password" Foreground="#AAB4BB" FontSize="11.5" VerticalAlignment="Center"/>
                      <PasswordBox Grid.Column="1" x:Name="LoginPasswordBox" MinHeight="24" Margin="4,0,0,0"/>
                      <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Content="Login" Margin="6,4,0,4" Click="OnLocalLoginClick"/>
                      <Button Grid.Column="3" x:Name="CreateUserBtn" Style="{StaticResource MiniBtn}" Content="Add" Margin="6,4,0,4" Click="OnCreateLocalUserClick" ToolTip="Admin only: create local user with selected role."/>
                      <Button Grid.Column="4" x:Name="ChangePasswordBtn" Style="{StaticResource MiniBtn}" Content="Set PW" Margin="6,4,0,4" Click="OnChangeLocalPasswordClick" ToolTip="Admin only: set password for the local user in Operator field."/>
                      <Button Grid.Column="5" x:Name="DisableUserBtn" Style="{StaticResource MiniBtn}" Content="Disable" Margin="6,4,0,4" Click="OnDisableLocalUserClick" ToolTip="Admin only: disable the local user in Operator field."/>
                      <Button Grid.Column="6" x:Name="DeleteUserBtn" Style="{StaticResource MiniBtn}" Content="Delete" Margin="6,4,0,4" Click="OnDeleteLocalUserClick" ToolTip="Admin only: delete the local user in Operator field."/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- â•â• ROW 2: Status strip â•â• -->
      <Grid Grid.Row="2" Background="#1B2024" MinHeight="106">
        <Border BorderBrush="#3C444B" BorderThickness="0,0,0,1">
          <UniformGrid Columns="4" Rows="2">
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Database" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="DatabaseStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Image Vault" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="ImageVaultStatusText" Text="Not Available" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Inspection Engine" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="InspectionEngineStatusText" Text="Pixel Difference Prototype Engine" Foreground="#E1A334" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Camera" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="CameraStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Lighting" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="LightingStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="Robot" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="RobotStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="#3B434A" BorderThickness="0,0,1,0" Padding="10,6">
              <StackPanel>
                <TextBlock Text="MES / Traceability" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="MesStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Padding="10,6">
              <StackPanel>
                <TextBlock Text="E-Stop Monitor" Foreground="#8B969E" FontSize="10.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="EmergencyStopStatusText" Text="Not Connected" Foreground="#F27777" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </UniformGrid>
        </Border>
      </Grid>

      <!-- â•â• ROW 3: Main content â•â• -->
      <Grid Grid.Row="3" Background="#0B0E10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#111518">
          <Border BorderBrush="#4A535C" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Station ID -->
              <Border Grid.Row="0" BorderBrush="#363F46" BorderThickness="0,0,0,1" Padding="8,10">
                <StackPanel>
                  <Border Background="#0B0E10" BorderBrush="#58616A" BorderThickness="1" Padding="8">
                    <TextBlock Text="AOI-LIB" FontSize="15" FontWeight="ExtraBold"
                               Foreground="#E8EDF2" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="local review console / prototype"
                             Foreground="#87939B" FontSize="10" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Nav stack -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavPages}" Margin="8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Key}"
                              IsEnabled="{Binding IsEnabled}">
                        <Grid>
                          <!-- Active left accent -->
                          <Rectangle Width="3" HorizontalAlignment="Left" Fill="Transparent" x:Name="Accent"/>
                          <Grid Margin="3,5,8,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}"
                                       FontFamily="Consolas" FontSize="10.5"
                                       Foreground="#9EADB7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                         FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              <TextBlock Text="{Binding Subtitle}"
                                         FontSize="9.5" Foreground="#7F8C95" Margin="0,2,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Grid>
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#25313A"/>
                                <Setter Property="BorderBrush" Value="#82A8C2"/>
                                <Setter Property="Foreground"  Value="#F5F9FB"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Alarm panel -->
              <Border Grid.Row="2" Background="#0C0F11" BorderBrush="#3A4249" BorderThickness="0,1,0,0" Padding="8">
                <StackPanel>
                  <TextBlock Text="ACTIVE MESSAGE" Foreground="#F0A0A0" FontWeight="ExtraBold" FontSize="10.5" Margin="0,0,0,5"/>
                  <TextBlock Text="Prototype runs local file-based inspection only." Foreground="#ED6262" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock Text="Planned: camera/lighting/3D Stage 2; robot Stage 3; MES/ERP Stage 4."
                             Foreground="#ED6262" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Main panel -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Page title bar -->
          <Grid Grid.Row="0" Background="#0F1316" x:Name="PageTitleBar">
            <Border BorderBrush="#30383F" BorderThickness="0,0,0,1">
              <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Border Background="#172027" BorderBrush="#34414A" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Sample " Foreground="#8FA0AB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowSampleText" Text="none" Foreground="#DCE5EB" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#172027" BorderBrush="#34414A" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Golden " Foreground="#8FA0AB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowGoldenText" Text="none" Foreground="#DCE5EB" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#1A2430" BorderBrush="#3B5B77" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Score " Foreground="#9AB1C4" FontSize="10"/>
                      <TextBlock x:Name="WorkflowScoreText" Text="--" Foreground="#CFEAFF" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="WorkflowVerdictBorder" Background="#2A2E31" BorderBrush="#555E66" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Verdict " Foreground="#AAB4BB" FontSize="10"/>
                      <TextBlock x:Name="WorkflowVerdictText" Text="REVIEW" Foreground="#DCE5EB" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Button Style="{StaticResource MiniBtn}" Content="Refresh" Margin="0,0,6,0" Click="OnRefreshClick"/>
                  <Button x:Name="LockRecipeBtn" Style="{StaticResource MiniBtnAmber}" Content="Lock Recipe" Margin="0,0,6,0" Click="OnLockRecipeClick"/>
                  <Button x:Name="ExportBtn" Style="{StaticResource MiniBtnGreen}" Content="Export" Click="OnExportClick"/>
                </StackPanel>
                <TextBlock x:Name="PageTitleText"
                           Foreground="#E8EDF2" FontWeight="ExtraBold" FontSize="12.5"
                           VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Page content (swapped by code-behind) -->
          <ContentControl Grid.Row="1" x:Name="PageContent"/>
        </Grid>
      </Grid>

      <!-- â•â• ROW 4: Footer â•â• -->
      <Grid Grid.Row="4" Background="#0A0D0F">
        <Border BorderBrush="#374047" BorderThickness="0,1,0,0">
          <DockPanel Margin="8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="Station " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterStationText" Text="AOI-LIB-01" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="Index " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterIndexText" Text="SQLite" FontWeight="Bold" Foreground="#50F56E" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DB Updated " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterDbUpdatedText" Text="--" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="REC " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterRecordCountText" Text="0" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="IMG LINK " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterImageLinkText" Text="0/0" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DB REV " Foreground="#8D99A1" FontSize="11.5"/>
                <TextBlock x:Name="FooterDbRevText" Text="local" FontWeight="Bold" Foreground="#D4DDE3" FontSize="11.5"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

    </Grid>
  </Border>
</Window>
