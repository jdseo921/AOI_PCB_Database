<Window x:Class="AOI_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AOI_Monitor.ViewModels"
        Title="PCBA AOI Review Console"
        Width="1920" Height="1080" MinWidth="1600" MinHeight="900"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Border x:Name="ShellRootBorder" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#0D2438" MinHeight="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#2B4658" BorderThickness="0,0,1,0">
          <TextBlock Text="{Binding ClockText}"
                     FontFamily="Consolas"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#F7FAFC"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Column="1" Margin="14,6" MinWidth="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="BrandLogoImage"
                   Width="26"
                   Height="26"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   Margin="0,0,10,0"/>
            <Ellipse x:Name="BrandAccentDot" Width="18" Height="18" VerticalAlignment="Center" Fill="#1EA7A1"/>
            <TextBlock x:Name="BrandTitleText"
                       Text="PCBA AOI REVIEW CONSOLE"
                       Foreground="#FFFFFF"
                       FontSize="19"
                       FontWeight="ExtraBold"
                       VerticalAlignment="Center"
                       Margin="10,0,12,0"
                       MaxWidth="360"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            <Border x:Name="OperatingModeBanner" Style="{StaticResource HmiPersistentBanner}" Background="#2A1740" BorderBrush="#8F5FD1">
              <TextBlock x:Name="OperatingModeBannerText" Text="Demo Mode" Foreground="#F1D8FF" FontSize="14" FontWeight="ExtraBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Border>
            <Border x:Name="DeploymentProfileBanner" Style="{StaticResource HmiPersistentBanner}" Background="#172A39" BorderBrush="#5CA0D3">
              <StackPanel Orientation="Horizontal" MaxWidth="290">
                <TextBlock Text="Profile " Foreground="#B7C8D8" FontSize="14"/>
                <TextBlock x:Name="DeploymentProfileBannerText" Text="Stage 1 Image Validation" Foreground="#E7F5FF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border x:Name="SimulationWarningBanner" Style="{StaticResource HmiPersistentBanner}" Background="#372914" BorderBrush="#E1A334">
              <TextBlock x:Name="SimulationWarningBannerText" Text="SIMULATED / MOCK SOURCES ACTIVE" Foreground="#FFE0A7" FontSize="14" FontWeight="ExtraBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="270" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Border>
          </WrapPanel>

          <TextBlock Grid.Row="1"
                     Text="Navigation-first AOI console for image validation, defect review, recipe control, traceable exports, and staged hardware readiness."
                     Foreground="#C9D8E4"
                     FontSize="14"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                     Margin="0,2,0,0"/>
        </Grid>

        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,5,10,5" MaxWidth="780">
          <Border Style="{StaticResource HmiPersistentBanner}" Background="#14262E" BorderBrush="#4C6A7D">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="User " Foreground="#AAB4BB" FontSize="14"/>
              <TextBlock x:Name="HeaderUserText" Text="Engineer01" Foreground="#E8EEF2" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text=" / " Foreground="#AAB4BB" FontSize="14"/>
              <TextBlock x:Name="HeaderRoleText" Text="Admin" Foreground="#E8EEF2" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="92" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HmiPersistentBanner}" Background="#14262E" BorderBrush="#4C6A7D">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Engine " Foreground="#AAB4BB" FontSize="14"/>
              <TextBlock x:Name="HeaderEngineText" Text="Pixel Difference Prototype Engine" Foreground="#E8EEF2" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="250" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </Border>
          <Expander Header="Utilities / Access"
                    Foreground="#E8EEF2"
                    Background="#102332"
                    BorderBrush="#486171"
                    BorderThickness="1"
                    Padding="10,4"
                    Margin="8,0,0,0"
                    MinWidth="210"
                    MaxWidth="720"
                    IsExpanded="False">
            <Border Background="#0F151A" BorderBrush="#384854" BorderThickness="1" Padding="10" Margin="0,6,0,0">
              <StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="FileMenuBtn" Style="{StaticResource MiniBtn}" Content="File" Margin="0,0,6,6" Click="OnMenuFileClick"/>
                  <Button x:Name="ReportIssueBtn" Style="{StaticResource MiniBtnAmber}" MinWidth="120" Content="Report Issue" Margin="0,0,6,6" Click="OnReportIssueClick"/>
                  <Button x:Name="LayoutStressBtn" Style="{StaticResource MiniBtn}" MinWidth="120" Content="Layout Stress" Margin="0,0,6,6" Click="OnLayoutStressClick"/>
                  <Button x:Name="SupportBundleBtn" Style="{StaticResource MiniBtn}" MinWidth="140" Content="Support Bundle" Margin="0,0,0,6" Click="OnExportSupportBundleClick"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                  <Border Width="220" BorderBrush="#2D343A" BorderThickness="1" Padding="8,4" Margin="0,0,6,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="User" Foreground="#AAB4BB" FontSize="14" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" x:Name="UserIdText" Text="Engineer01" Margin="6,0,0,0"/>
                    </Grid>
                  </Border>
                  <Border Width="190" BorderBrush="#2D343A" BorderThickness="1" Padding="8,4" Margin="0,0,6,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Role" Foreground="#E1A334" FontSize="14" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="RoleCombo" SelectedIndex="2" Margin="4,0,0,0" SelectionChanged="OnRoleSelectionChanged">
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="Engineer"/>
                        <ComboBoxItem Content="Admin"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Width="300" BorderBrush="#2D343A" BorderThickness="1" Padding="8,4" Margin="0,0,0,6">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Auth" Foreground="#AAB4BB" FontSize="14" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="AuthModeCombo" SelectedIndex="0" Margin="4,0,0,0" SelectionChanged="OnAuthModeSelectionChanged">
                        <ComboBoxItem Content="DemoLocalRoleSelector"/>
                        <ComboBoxItem Content="LocalUsers"/>
                        <ComboBoxItem Content="MesAuthenticationBoundary"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                </WrapPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="PW" Foreground="#AAB4BB" FontSize="14" VerticalAlignment="Center"/>
                  <PasswordBox Grid.Column="1" x:Name="LoginPasswordBox" MinHeight="34" Margin="4,0,8,0"/>
                  <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Content="Login" Click="OnLocalLoginClick"/>
                </Grid>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                  <Button x:Name="CreateUserBtn" Style="{StaticResource MiniBtn}" Content="Add User" Margin="6,0,0,0" Click="OnCreateLocalUserClick"/>
                  <Button x:Name="ChangePasswordBtn" Style="{StaticResource MiniBtn}" Content="Set PW" Margin="6,0,0,0" Click="OnChangeLocalPasswordClick"/>
                  <Button x:Name="DisableUserBtn" Style="{StaticResource MiniBtn}" Content="Disable" Margin="6,0,0,0" Click="OnDisableLocalUserClick"/>
                  <Button x:Name="DeleteUserBtn" Style="{StaticResource MiniBtn}" Content="Delete" Margin="6,0,0,0" Click="OnDeleteLocalUserClick"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Expander>
        </WrapPanel>
      </Grid>

      <Border Grid.Row="1" Background="#101820" BorderBrush="#2E3D47" BorderThickness="0,0,0,1" Padding="10,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="StationNameText" Text="AOI-LIB" Foreground="#F7FAFC" FontSize="18" FontWeight="ExtraBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            <TextBlock x:Name="StationSubtitleText" Text="local review console / prototype" Foreground="#9AA6AF" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Margin="0,1,0,0"/>
          </StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="StationBadgeBorder" Style="{StaticResource HmiShellCompactStatusBadge}" Background="#172A39" BorderBrush="#477CA5">
              <TextBlock Text="Station Ready" Foreground="#D7F0FF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#14311D" BorderBrush="#3C8D50">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Database " Foreground="#BFECC8" FontSize="14"/>
                <TextBlock x:Name="DatabaseStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="115" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#14311D" BorderBrush="#3C8D50">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Image Vault " Foreground="#BFECC8" FontSize="14"/>
                <TextBlock x:Name="ImageVaultStatusText" Text="Not Available" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="110" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#372914" BorderBrush="#987538">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Engine " Foreground="#FFE0A7" FontSize="14"/>
                <TextBlock x:Name="InspectionEngineStatusText" Text="Pixel Difference Prototype Engine" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#35191B" BorderBrush="#A13A3F">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Camera " Foreground="#FFD0D2" FontSize="14"/>
                <TextBlock x:Name="CameraStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#35191B" BorderBrush="#A13A3F">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lighting " Foreground="#FFD0D2" FontSize="14"/>
                <TextBlock x:Name="LightingStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#35191B" BorderBrush="#A13A3F">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Robot " Foreground="#FFD0D2" FontSize="14"/>
                <TextBlock x:Name="RobotStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#35191B" BorderBrush="#A13A3F">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="MES / Trace " Foreground="#FFD0D2" FontSize="14"/>
                <TextBlock x:Name="MesStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource HmiShellCompactStatusBadge}" Background="#35191B" BorderBrush="#A13A3F">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="E-Stop " Foreground="#FFD0D2" FontSize="14"/>
                <TextBlock x:Name="EmergencyStopStatusText" Text="Not Connected" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <Expander x:Name="ActiveAlarmsExpander"
                    Grid.Column="2"
                    Foreground="#F7FAFC"
                    Background="#141D24"
                    BorderBrush="#3A4A55"
                    BorderThickness="1"
                    Padding="8,4"
                    Margin="8,0,0,0"
                    IsExpanded="False"
                    HorizontalAlignment="Right"
                    MinWidth="310"
                    MaxWidth="470"
                    Expanded="OnActiveAlarmsExpanded"
                    Collapsed="OnActiveAlarmsCollapsed">
            <Expander.Header>
              <Grid MinWidth="260">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Alarms" Foreground="#F7FAFC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActiveAlarmHeaderText"
                           Grid.Column="1"
                           Text="none"
                           Foreground="#B9C4CC"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              </Grid>
            </Expander.Header>
            <Border Background="#0C0F11" BorderBrush="#3A4249" BorderThickness="1" Padding="8" Margin="0,8,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="124"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ACTIVE ALARMS" Foreground="#F0A0A0" FontWeight="ExtraBold" FontSize="14"/>
                <TextBlock Grid.Row="1" x:Name="ActiveAlarmSummaryText" Text="No active alarms." Foreground="#DCE5EB" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <StackPanel Grid.Row="2">
                  <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="AlarmSeverityFilterCombo" Width="150" MinHeight="34" SelectionChanged="OnAlarmFilterChanged">
                      <ComboBoxItem Content="All severities" IsSelected="True"/>
                      <ComboBoxItem Content="Info"/>
                      <ComboBoxItem Content="Warning"/>
                      <ComboBoxItem Content="Alarm"/>
                      <ComboBoxItem Content="Critical"/>
                    </ComboBox>
                    <ComboBox x:Name="AlarmSortCombo" Width="170" MinHeight="34" Margin="6,0,0,0" SelectionChanged="OnAlarmFilterChanged">
                      <ComboBoxItem Content="Severity high first" IsSelected="True"/>
                      <ComboBoxItem Content="Newest first"/>
                      <ComboBoxItem Content="Oldest first"/>
                      <ComboBoxItem Content="Severity low first"/>
                    </ComboBox>
                  </StackPanel>
                  <TextBox x:Name="AlarmSourceFilterText" MinHeight="34" Margin="0,6,0,6" TextChanged="OnAlarmSourceFilterTextChanged"/>
                  <ListBox x:Name="AlarmListBox"
                           Height="74"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           Background="#090B0D"
                           BorderBrush="#384149"
                           Foreground="#E8EEF2">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="4">
                          <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding ActionSummary}" FontSize="14" Foreground="#B7C2CA" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="AcknowledgeAlarmBtn" Style="{StaticResource MiniBtnAmber}" Content="Acknowledge" Margin="0,0,6,0" Click="OnAcknowledgeAlarmClick"/>
                  <Button x:Name="AlarmDetailsBtn" Style="{StaticResource MiniBtn}" Content="Details" Margin="0,0,6,0" Click="OnAlarmDetailsClick"/>
                  <Button x:Name="ExportAlarmLogBtn" Style="{StaticResource MiniBtnGreen}" Content="Export Log" Click="OnExportAlarmLogClick"/>
                </WrapPanel>
              </Grid>
            </Border>
          </Expander>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="286"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="AOI Workflow" Foreground="#E8EEF2" FontSize="18" FontWeight="ExtraBold" Margin="2,0,0,12"/>
            <ScrollViewer x:Name="TopLevelNavScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="TopLevelNavItems" ItemsSource="{Binding NavPages}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Key}"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip="{Binding Subtitle}"
                            Margin="0,0,0,8"
                            MinHeight="68">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                          <Setter Property="Padding" Value="0"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Background" Value="#21384A"/>
                              <Setter Property="BorderBrush" Value="#79B8E2"/>
                              <Setter Property="Foreground" Value="#F5F9FB"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Grid Margin="10,7">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="42"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#1F6FEB" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Number}" Foreground="#FFFFFF" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource HmiShellNavTitleText}" ToolTip="{Binding Title}"/>
                          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HmiShellNavSubtitleText}" ToolTip="{Binding Subtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Background="#0F151A" x:Name="PageTitleBar" MinHeight="54">
            <Border BorderBrush="#30383F" BorderThickness="0,0,0,1" Padding="12,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitleText"
                           Foreground="#E8EDF2"
                           FontWeight="ExtraBold"
                           FontSize="19"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="48"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                <WrapPanel Grid.Column="1"
                           x:Name="WorkflowToolbarPanel"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           MaxWidth="860">
                  <Border Style="{StaticResource HmiShellValueChip}" Background="#172027" BorderBrush="#34414A">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Sample " Foreground="#8FA0AB" FontSize="14"/>
                      <TextBlock x:Name="WorkflowSampleText" Grid.Column="1" Text="none" Foreground="#DCE5EB" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource HmiShellValueChip}" Background="#172027" BorderBrush="#34414A">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Golden " Foreground="#8FA0AB" FontSize="14"/>
                      <TextBlock x:Name="WorkflowGoldenText" Grid.Column="1" Text="none" Foreground="#DCE5EB" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource HmiShellValueChip}" Background="#1A2430" BorderBrush="#3B5B77" MaxWidth="128">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Score " Foreground="#9AB1C4" FontSize="14"/>
                      <TextBlock x:Name="WorkflowScoreText" Grid.Column="1" Text="--" Foreground="#CFEAFF" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </Grid>
                  </Border>
                  <Border x:Name="WorkflowVerdictBorder" Style="{StaticResource HmiShellValueChip}" Background="#2A2E31" BorderBrush="#555E66" MaxWidth="160">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Verdict " Foreground="#AAB4BB" FontSize="14"/>
                      <TextBlock x:Name="WorkflowVerdictText" Grid.Column="1" Text="REVIEW" Foreground="#DCE5EB" FontSize="14" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </Grid>
                  </Border>
                  <Button x:Name="RefreshPageBtn" Style="{StaticResource MiniBtn}" Content="Refresh" MinWidth="104" Margin="0,0,6,6" Click="OnRefreshClick"/>
                  <Button x:Name="LockRecipeBtn" Style="{StaticResource MiniBtnAmber}" Content="Lock Recipe" MinWidth="118" Margin="0,0,6,6" Click="OnLockRecipeClick"/>
                  <Button x:Name="ExportBtn" Style="{StaticResource MiniBtnGreen}" Content="Export" MinWidth="104" Margin="0,0,0,6" Click="OnExportClick"/>
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <ContentControl x:Name="PageContent"/>
            <Border x:Name="PageErrorCard"
                    Background="#EE151A1E"
                    BorderBrush="#9A393E"
                    BorderThickness="1"
                    Margin="18"
                    Padding="18"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="15">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Recoverable page error" Foreground="#FFCDD0" FontSize="16" FontWeight="Bold"/>
                  <TextBlock x:Name="PageErrorText" Text="The page failed to refresh." Foreground="#E8EEF2" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                  <Button Style="{StaticResource MiniBtn}" Content="Retry" Margin="0,0,8,0" Click="OnRefreshClick"/>
                  <Button Style="{StaticResource MiniBtn}" Content="Dismiss" Click="OnDismissPageErrorClick"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="LoadingOverlay" Background="#CC050607" Visibility="Collapsed" Panel.ZIndex="20">
              <Border Background="#151A1E" BorderBrush="#5A646D" BorderThickness="1" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260">
                <StackPanel>
                  <TextBlock x:Name="LoadingOverlayText" Text="Loading..." Foreground="#E8EEF2" FontWeight="Bold" FontSize="15" TextAlignment="Center"/>
                  <ProgressBar IsIndeterminate="True" Height="8" Margin="0,12,0,0"/>
                  <Button x:Name="CancelPageLoadBtn" Style="{StaticResource MiniBtn}" Content="Cancel" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnCancelPageLoadClick"/>
                </StackPanel>
              </Border>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Grid Grid.Row="3" Background="#081018" MinHeight="30">
        <Border BorderBrush="#2E3D47" BorderThickness="0,1,0,0">
          <DockPanel Margin="10,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" MaxWidth="520">
              <TextBlock Text="Station " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterStationText" Text="AOI-LIB-01" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="Index " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterIndexText" Text="SQLite" FontWeight="Bold" Foreground="#50F56E" FontSize="14" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="110" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="DB Updated " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterDbUpdatedText" Text="--" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="120" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" MaxWidth="520">
              <TextBlock Text="REC " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterRecordCountText" Text="0" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="70" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="IMG LINK " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterImageLinkText" Text="0/0" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" Margin="0,0,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="90" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
              <TextBlock Text="DB REV " Foreground="#8D99A1" FontSize="14"/>
              <TextBlock x:Name="FooterDbRevText" Text="local" FontWeight="Bold" Foreground="#D4DDE3" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="110" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
