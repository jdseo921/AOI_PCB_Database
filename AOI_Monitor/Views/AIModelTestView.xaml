<UserControl x:Class="AOI_Monitor.Views.AIModelTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <UserControl.Resources>
    <Style x:Key="BatchResultRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFailed}" Value="True">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="Foreground" Value="#FFCDD0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding PassFail}" Value="N/A">
          <Setter Property="Background" Value="#252417"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOverOneSecond}" Value="True">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="Foreground" Value="#FFE1A3"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultStatusChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding PassFail}" Value="PASS">
          <Setter Property="Background" Value="#14311D"/>
          <Setter Property="BorderBrush" Value="#377849"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding PassFail}" Value="FAIL">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding PassFail}" Value="N/A">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="25"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Stage 1 Customer Validation" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
        </Border>
        <Grid Grid.Row="1" Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="260"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Test Image Folder" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
              <TextBox x:Name="FolderPathText" Style="{StaticResource ReadonlyInput}" Text="No folder selected"/>
              <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Content="Select" Click="OnSelectFolderClick"/>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Ground Truth CSV (optional)" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
              <TextBox x:Name="GroundTruthPathText" Style="{StaticResource ReadonlyInput}" Text="No CSV selected"/>
              <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Content="Select" Click="OnSelectGroundTruthClick"/>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Text="Engine" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="EngineText" Style="{StaticResource ReadonlyInput}" Text="Pixel Difference Prototype Engine"/>
            <Button Style="{StaticResource ActionBtnGreen}" Content="Run Batch Inspection" Margin="0,8,0,0" Click="OnRunBatchClick"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2">
      <UniformGrid Columns="4">
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Accuracy" Foreground="#7F8C95" FontSize="10"/>
            <TextBlock x:Name="AccuracyText" Text="--" FontWeight="Bold" FontSize="18"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Precision" Foreground="#7F8C95" FontSize="10"/>
            <TextBlock x:Name="PrecisionText" Text="--" FontWeight="Bold" FontSize="18"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Recall" Foreground="#7F8C95" FontSize="10"/>
            <TextBlock x:Name="RecallText" Text="--" FontWeight="Bold" FontSize="18"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource FieldBox}">
          <StackPanel>
            <TextBlock Text="False Call Rate" Foreground="#7F8C95" FontSize="10"/>
            <TextBlock x:Name="FalseCallRateText" Text="--" FontWeight="Bold" FontSize="18"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <UniformGrid Columns="7" Margin="0,6,0,0">
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="TP" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="TpText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="TN" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="TnText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="FP" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="FpText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="FN" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="FnText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="OK" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="OkCountText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="NG" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="NgCountText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}"><StackPanel><TextBlock Text="REVIEW" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="ReviewCountText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
      </UniformGrid>
      <UniformGrid Columns="4" Margin="0,6,0,0">
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="False Call" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="FalseCallText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Possible Escape" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="PossibleEscapeText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Verified NG" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="VerifiedNgText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}"><StackPanel><TextBlock Text="Unknown / Unlabeled" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="UnknownText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
      </UniformGrid>
      <UniformGrid Columns="4" Margin="0,6,0,0">
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Avg Time / Image" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="AverageTimeText" Text="--" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Max Time" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="MaxTimeText" Text="--" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Min Time" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="MinTimeText" Text="--" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
        <Border Style="{StaticResource FieldBox}"><StackPanel><TextBlock Text="Over 1 Second" Foreground="#7F8C95" FontSize="10"/><TextBlock x:Name="OverOneSecondText" Text="0" FontWeight="Bold" FontSize="16"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource FieldBox}" Margin="0,6,0,0">
        <StackPanel>
          <TextBlock Text="Dataset Quality Gate" Foreground="#7F8C95" FontSize="10"/>
          <TextBlock x:Name="DatasetQualityText" Text="--" FontWeight="Bold" FontSize="14"/>
          <TextBlock x:Name="DatasetQualityWarningsText" Text="" Foreground="#9AA6AF" FontSize="10.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource FieldBox}" Margin="0,6,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="92"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <ComboBox x:Name="FalseCallModeCombo" Width="190" SelectedIndex="1" Margin="0,0,6,0">
                <ComboBoxItem Content="Minimize False Positives"/>
                <ComboBoxItem Content="Balanced"/>
                <ComboBoxItem Content="Maximize Defect Recall"/>
              </ComboBox>
              <Button Style="{StaticResource ActionBtnBlue}" Content="Analyze False Calls" Margin="0,0,6,0" Click="OnAnalyzeFalseCallsClick"/>
              <Button x:Name="ApplyRecommendedThresholdButton" Style="{StaticResource ActionBtnAmber}" Content="Apply Recommended Threshold" IsEnabled="False" Click="OnApplyRecommendedThresholdClick"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="False Call Reduction / Labor Impact" Foreground="#DCE5EB" FontWeight="Bold" FontSize="11.5"/>
              <TextBlock x:Name="FalseCallRecommendationText" Text="Run a batch, then analyze threshold candidates." Foreground="#9AA6AF" FontSize="11"/>
            </StackPanel>
          </DockPanel>
          <DataGrid Grid.Row="1" x:Name="FalseCallGrid" Margin="0,6,0,0" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Threshold" Binding="{Binding ConfidenceThreshold, StringFormat=F3}" Width="82"/>
              <DataGridTextColumn Header="FP" Binding="{Binding FalsePositive}" Width="52"/>
              <DataGridTextColumn Header="FN" Binding="{Binding FalseNegative}" Width="52"/>
              <DataGridTextColumn Header="False Call" Binding="{Binding FalseCallRate, StringFormat=P1}" Width="86"/>
              <DataGridTextColumn Header="Escape" Binding="{Binding PossibleEscapeRate, StringFormat=P1}" Width="78"/>
              <DataGridTextColumn Header="Review" Binding="{Binding ReviewRate, StringFormat=P1}" Width="78"/>
              <DataGridTextColumn Header="Manual Min" Binding="{Binding EstimatedManualReviewMinutes, StringFormat=F1}" Width="88"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Style="{StaticResource FieldBox}" Margin="0,6,0,0">
        <TabControl x:Name="BreakdownTabs" Height="150">
          <TabItem Header="Defect Class">
            <DataGrid x:Name="DefectClassBreakdownGrid" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Class" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="TP" Binding="{Binding TruePositive}" Width="46"/>
                <DataGridTextColumn Header="FP" Binding="{Binding FalsePositive}" Width="46"/>
                <DataGridTextColumn Header="FN" Binding="{Binding FalseNegative}" Width="46"/>
                <DataGridTextColumn Header="Wrong" Binding="{Binding WrongDefectClass}" Width="58"/>
                <DataGridTextColumn Header="Recall" Binding="{Binding Recall, StringFormat=P1}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Side/View">
            <DataGrid x:Name="SideBreakdownGrid" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Side" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="TP" Binding="{Binding TruePositive}" Width="46"/>
                <DataGridTextColumn Header="FP" Binding="{Binding FalsePositive}" Width="46"/>
                <DataGridTextColumn Header="FN" Binding="{Binding FalseNegative}" Width="46"/>
                <DataGridTextColumn Header="Wrong Side" Binding="{Binding WrongSide}" Width="80"/>
                <DataGridTextColumn Header="False Call" Binding="{Binding FalseCallRate, StringFormat=P1}" Width="82"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="ROI">
            <DataGrid x:Name="RoiBreakdownGrid" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ROI" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="58"/>
                <DataGridTextColumn Header="FP" Binding="{Binding FalsePositive}" Width="46"/>
                <DataGridTextColumn Header="FN" Binding="{Binding FalseNegative}" Width="46"/>
                <DataGridTextColumn Header="Recall" Binding="{Binding Recall, StringFormat=P1}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Worst False Calls">
            <DataGrid x:Name="FalseCallSourcesGrid" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="FP" Binding="{Binding FalsePositive}" Width="52"/>
                <DataGridTextColumn Header="False Call" Binding="{Binding FalseCallRate, StringFormat=P1}" Width="88"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Possible Escapes">
            <DataGrid x:Name="EscapeSourcesGrid" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="FN" Binding="{Binding FalseNegative}" Width="52"/>
                <DataGridTextColumn Header="Recall" Binding="{Binding Recall, StringFormat=P1}" Width="78"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </Border>
    </StackPanel>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <TextBlock x:Name="RunSummaryText" DockPanel.Dock="Right" Text="No batch run loaded" Foreground="#9AA6AF" FontSize="11"/>
            <TextBlock Text="Batch Results" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="ResultsGrid" RowStyle="{StaticResource BatchResultRow}" SelectionChanged="OnResultSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="*"/>
            <DataGridTextColumn Header="Ground Truth" Binding="{Binding GroundTruth}" Width="110"/>
            <DataGridTextColumn Header="AI/Engine Result" Binding="{Binding EngineResult}" Width="120"/>
            <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="70"/>
            <DataGridTextColumn Header="Time" Binding="{Binding TotalTimeDisplay}" Width="80"/>
            <DataGridTemplateColumn Header="Pass/Fail" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ResultStatusChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                    <TextBlock Text="{Binding PassFail}" FontWeight="Bold" FontSize="9.5"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Defect / Hotspot" Binding="{Binding DefectType}" Width="140"/>
            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="70"/>
            <DataGridTextColumn Header="RefDes" Binding="{Binding RefDes}" Width="90"/>
            <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="100"/>
            <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="110"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="6" Style="{StaticResource Panel}">
      <DockPanel Margin="8">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Select a folder to run Stage 1 validation." Foreground="#9AA6AF"/>
          <TextBlock x:Name="ReportPathText" Text="Report: not generated" Foreground="#7F8C95" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ProgressBar x:Name="WorkProgressBar" Width="140" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <Button x:Name="CancelWorkButton" Style="{StaticResource ActionBtn}" Content="Cancel" Margin="0,0,6,0" IsEnabled="False" Click="OnCancelWorkClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Preview Selected" Margin="0,0,6,0" Click="OnPreviewSelectedClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Export CSV" Margin="0,0,6,0" Click="OnExportCsvClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Export Annotated Images" Margin="0,0,6,0" Click="OnExportAnnotatedImagesClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Export Validation Package" Click="OnGenerateReportClick"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
