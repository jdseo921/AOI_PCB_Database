<UserControl x:Class="AOI_Monitor.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Fill the viewport: the review-sequence table absorbs spare height (audit
         TrailingVoidPercent was 57.9% at 1080p before this). -->
    <Grid Margin="8" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Settings / Guide" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
          <TextBlock Text="Operator workflow reference with access to local settings and prototype installation notes."
                     Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,0">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Open Settings" Margin="0,0,6,0" Click="OnOpenSettingsClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Calibration" Margin="0,0,6,0" Click="OnOpenCalibrationClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Run Setup Wizard Again" Margin="0,0,6,0" Click="OnRunSetupWizardClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Export Diagnostics Report" Margin="0,0,6,0" Click="OnExportDiagnosticsClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Installation Notes" Click="OnOpenInstallClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Steps -->
    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Mandatory Review Sequence" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
        </Border>
        <DataGrid Grid.Row="1" x:Name="StepsGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#"           Binding="{Binding Num}"      Width="38"/>
            <DataGridTextColumn Header="Step"        Binding="{Binding Step}"     Width="*" ElementStyle="{StaticResource HmiDataGridCellText}"/>
            <DataGridTextColumn Header="Priority"    Binding="{Binding Priority}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Header info -->
    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Guide Header" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="{StaticResource HmiFontSizeBody}"/>
        </Border>
        <UniformGrid Grid.Row="1" Columns="3" Margin="8" Rows="1">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Default Policy" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Minimize False Positives" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="Primary Evidence" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Image + ROI + GT + Inspection Result" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="Commissioning Mode" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="{StaticResource HmiFontSizeBody}" Margin="0,0,0,2"/>
              <TextBlock Text="Local DB / No MES Writeback" FontWeight="Bold" FontSize="{StaticResource HmiFontSizeBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </Border>

    </Grid>
  </ScrollViewer>
</UserControl>

