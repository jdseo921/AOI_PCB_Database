<UserControl x:Class="AOI_Monitor.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
  <UserControl.Resources>
    <Style x:Key="HomeModuleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="88"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="{DynamicResource Frame2Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="HomeCompactStatusBorder" TargetType="Border" BasedOn="{StaticResource HmiAdaptiveStatusUnavailable}">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="136"/>
      <Setter Property="MaxWidth" Value="178"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="HomeStatusLabel" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="HomeStatusValue" TargetType="TextBlock" BasedOn="{StaticResource FactoryTrimmedTextWithTooltip}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="MaxWidth" Value="104"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource FactoryScrollablePage}">
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="5"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
          <TextBlock x:Name="HomeAlarmSummaryText"
                     DockPanel.Dock="Right"
                     Text="Critical status: none"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="14"
                     FontWeight="ExtraBold"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="330"
                     ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
          <TextBlock Text="Home"
                     Style="{StaticResource HmiPageTitleText}"
                     FontSize="18"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"/>
        </DockPanel>

        <WrapPanel Grid.Row="2" Orientation="Horizontal">
          <Border x:Name="HomeDatabaseStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="DB" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeDatabaseStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeImageVaultStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Vault" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeImageVaultStatusText" Text="Not Available" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeEngineStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Engine" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeEngineStatusText" Text="Pixel Difference Prototype Engine" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeCameraStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Camera" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeCameraStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeLightingStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Light" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeLightingStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeRobotStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="Robot" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeRobotStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeMesStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="MES" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeMesStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
          <Border x:Name="HomeEStopStatusBorder" Style="{StaticResource HomeCompactStatusBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="E-Stop" Style="{StaticResource HomeStatusLabel}" Margin="0,0,6,0"/>
              <TextBlock x:Name="HomeEStopStatusText" Text="Not Connected" Style="{StaticResource HomeStatusValue}"/>
            </DockPanel>
          </Border>
        </WrapPanel>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.95*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="AOI Workflow Menus" Style="{StaticResource HmiSectionHeaderText}" FontSize="16"/>
          <ItemsControl x:Name="HomeModuleItems" Grid.Row="2" ItemsSource="{Binding NavPages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource HomeModuleButton}"
                        IsEnabled="{Binding IsEnabled}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Key}">
                  <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource BlueBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}"
                                 Foreground="White"
                                 FontSize="14"
                                 FontWeight="ExtraBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontSize="15"
                                 FontWeight="ExtraBold"
                                 TextWrapping="Wrap"
                                 LineHeight="18"/>
                      <TextBlock Text="{Binding Subtitle}"
                                 Foreground="{DynamicResource MutedBrush}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 LineHeight="17"
                                 Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Current State" Style="{StaticResource HmiSectionHeaderText}" FontSize="16"/>
          <Border Grid.Row="2" Style="{StaticResource FactoryCard}" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Sample" Style="{StaticResource HomeStatusLabel}"/>
              <TextBlock x:Name="HomeSampleText" Grid.Column="1" Text="none" Style="{StaticResource HmiAdaptiveFieldWrappedValueText}" FontWeight="Bold"/>
              <TextBlock Grid.Row="2" Text="Golden" Style="{StaticResource HomeStatusLabel}"/>
              <TextBlock x:Name="HomeGoldenText" Grid.Row="2" Grid.Column="1" Text="none" Style="{StaticResource HmiAdaptiveFieldWrappedValueText}" FontWeight="Bold"/>
              <TextBlock Grid.Row="4" Text="Score" Style="{StaticResource HomeStatusLabel}"/>
              <TextBlock x:Name="HomeScoreText" Grid.Row="4" Grid.Column="1" Text="--" Style="{StaticResource HmiAdaptiveFieldWrappedValueText}" FontWeight="Bold"/>
              <TextBlock Grid.Row="6" Text="Recipe" Style="{StaticResource HomeStatusLabel}"/>
              <TextBlock x:Name="HomeRecipeText" Grid.Row="6" Grid.Column="1" Text="PIXEL_DIFF_0.1" Style="{StaticResource HmiAdaptiveFieldWrappedValueText}" FontWeight="Bold"/>
              <Border x:Name="HomeVerdictBorder" Grid.Row="8" Grid.ColumnSpan="2" Background="#372914" BorderBrush="#987538" BorderThickness="2" Padding="8,5">
                <DockPanel LastChildFill="True">
                  <TextBlock Text="Verdict" Foreground="{DynamicResource MutedBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="HomeVerdictText" Text="REVIEW" Foreground="#FFE0A7" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Right" TextAlignment="Right"/>
                </DockPanel>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="4" Style="{StaticResource HmiPlainLanguageNote}" Padding="8">
            <StackPanel>
              <TextBlock Text="Evidence Boundary" Style="{StaticResource HmiSectionHeaderText}" FontSize="16"/>
              <TextBlock Text="Stage 1 image-validation evidence is for review. Camera, lighting, robot, safety, and MES readiness still require Hardware Readiness evidence before any real factory-integration claim."
                         Style="{StaticResource HmiPageSubtitleText}" LineHeight="18" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
