<UserControl x:Class="AOI_Monitor.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
  <UserControl.Resources>
    <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource FactoryCard}">
      <Setter Property="Background" Value="{DynamicResource CellBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="MinHeight" Value="82"/>
    </Style>
    <Style x:Key="HomeModuleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="92"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Background" Value="{DynamicResource Frame2Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource FactoryScrollablePage}">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource HomeCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Station AOI-LIB-01" Style="{StaticResource HmiPageTitleText}" FontSize="22"/>
            <WrapPanel Margin="0,8,0,0">
              <TextBlock Text="Camera: Stage 1 folder source" Foreground="{DynamicResource GreenBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,18,0"/>
              <TextBlock Text="Lighting: simulated boundary" Foreground="{DynamicResource AmberBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,18,0"/>
              <TextBlock Text="DB: SQLite local cache" Foreground="{DynamicResource GreenBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,18,0"/>
              <TextBlock Text="Robot/MES: not production-connected" Foreground="{DynamicResource PurpleBrush}" FontSize="14" FontWeight="Bold"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Text="Product" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
            <TextBlock Text="TBOX-MAIN" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="ExtraBold" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="18,0,0,0">
            <TextBlock Text="Recipe" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
            <TextBlock Text="PIXEL_DIFF_0.1 / Active" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="ExtraBold" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Margin="18,0,0,0">
            <TextBlock Text="Inspection Basis" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
            <TextBlock Text="Image validation PoC" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="ExtraBold" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Focused Workflow Windows" Style="{StaticResource HmiPageTitleText}" FontSize="22"/>
          <ItemsControl x:Name="HomeModuleItems" Grid.Row="2" ItemsSource="{Binding NavPages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource HomeModuleButton}"
                        IsEnabled="{Binding IsEnabled}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Key}">
                  <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            Background="{DynamicResource BlueBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}"
                                 Foreground="White"
                                 FontSize="15"
                                 FontWeight="ExtraBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontSize="17"
                                 FontWeight="ExtraBold"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Subtitle}"
                                 Foreground="{DynamicResource MutedBrush}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 LineHeight="19"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="AOI Inspection Pipeline" Style="{StaticResource HmiPageTitleText}" FontSize="22"/>
          <Border Grid.Row="2" Style="{StaticResource HomeCard}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <UniformGrid Columns="2">
                <Border Style="{StaticResource FieldBox}" Background="{DynamicResource Frame2Bg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="Input" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="PNG/JPG, AOI files, golden images" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FieldBox}" Background="{DynamicResource Frame2Bg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="Register" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="Fiducials, rotation, X/Y offset" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FieldBox}" Background="{DynamicResource Frame2Bg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="Inspect" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="Component, solder, polarity, surface" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FieldBox}" Background="{DynamicResource Frame2Bg}" BorderBrush="{DynamicResource LineBrush}">
                  <StackPanel>
                    <TextBlock Text="Export" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="Evidence, coordinates, IPC class, MES" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <UniformGrid Grid.Row="2" Columns="2">
                <Border Style="{StaticResource HmiKpiCard}" Background="{DynamicResource CellBg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,8,8">
                  <StackPanel>
                    <TextBlock Text="Boards inspected" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="1,284" Style="{StaticResource MetricValue}" Foreground="{DynamicResource GreenBrush}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiKpiCard}" Background="{DynamicResource CellBg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="First-pass yield" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="98.2%" Style="{StaticResource MetricValue}" Foreground="{DynamicResource BlueBrush}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiKpiCard}" Background="{DynamicResource CellBg}" BorderBrush="{DynamicResource LineBrush}" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="Pending review" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="17" Style="{StaticResource MetricValue}" Foreground="{DynamicResource AmberBrush}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource HmiKpiCard}" Background="{DynamicResource CellBg}" BorderBrush="{DynamicResource LineBrush}">
                  <StackPanel>
                    <TextBlock Text="Critical defects" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    <TextBlock Text="3" Style="{StaticResource MetricValue}" Foreground="{DynamicResource RedBrush}"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Grid.Row="4" Style="{StaticResource HmiPlainLanguageNote}">
                <StackPanel>
                  <TextBlock Text="Capability groups" Style="{StaticResource HmiSectionHeaderText}"/>
                  <TextBlock Text="Board and image management, defect detection algorithms, processing and tolerance rules, and output traceability are split into dedicated windows so dense inspection work does not crowd the main review screen."
                             Style="{StaticResource HmiPageSubtitleText}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="4" Style="{StaticResource HomeCard}">
            <StackPanel>
              <TextBlock Text="Current Evidence Boundary" Style="{StaticResource HmiSectionHeaderText}"/>
              <TextBlock Text="Stage 1 image-validation evidence is visible and usable. Real camera, lighting, robot, and MES readiness must be validated through Hardware Readiness evidence before it can be represented as production hardware readiness."
                         Style="{StaticResource HmiPageSubtitleText}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="4" Style="{StaticResource HomeCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.3*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Recent Jobs" Style="{StaticResource HmiSectionHeaderText}"/>
            <UniformGrid Columns="4" Margin="0,10,0,0">
              <TextBlock Text="Lot" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
              <TextBlock Text="Product" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
              <TextBlock Text="Status" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
              <TextBlock Text="Review" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
              <TextBlock Text="POC-LOT" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
              <TextBlock Text="TBOX-MAIN" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
              <TextBlock Text="RUNNING" Foreground="{DynamicResource GreenBrush}" FontSize="14" FontWeight="Bold"/>
              <TextBlock Text="17 pending" Foreground="{DynamicResource AmberBrush}" FontSize="14" FontWeight="Bold"/>
            </UniformGrid>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="24,0,0,0">
            <TextBlock Text="Separated-window design rule" Style="{StaticResource HmiSectionHeaderText}"/>
            <TextBlock Text="Use the home map to enter the narrow window needed for the task. New features should become a focused page, tab, or dialog when they would crowd inspection, review, settings, or export workflows."
                       Style="{StaticResource HmiPageSubtitleText}" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
