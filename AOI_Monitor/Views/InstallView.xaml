<UserControl x:Class="AOI_Monitor.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <StackPanel Margin="8">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Runtime table -->
      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Background Runtime" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="RuntimeGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Runtime Element" Binding="{Binding Element}"  Width="180"/>
              <DataGridTextColumn Header="Status"          Binding="{Binding Status}"   Width="70"/>
              <DataGridTextColumn Header="Purpose"         Binding="{Binding Purpose}"  Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Height" Value="40"/>
              </Style>
            </DataGrid.RowStyle>
          </DataGrid>
        </Grid>
      </Border>

      <!-- GUI role -->
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="GUI Role" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </Border>
          <UniformGrid Grid.Row="1" Columns="1" Margin="8" Rows="4">
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Core Runtime"       Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="Background Service"        FontWeight="Bold" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Visible GUI"         Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="Monitor + Review Console"   FontWeight="Bold" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,6"><StackPanel><TextBlock Text="Default Page"        Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="Station Monitor"            FontWeight="Bold" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Operator Dependency"  Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="Review / Exception Only"     FontWeight="Bold" FontSize="12"/></StackPanel></Border>
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Installation boundary -->
    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Installation Boundary" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
        </Border>
        <DataGrid Grid.Row="1" x:Name="BoundaryGrid" MaxHeight="140">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Topic"       Binding="{Binding Topic}"   Width="175"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Desc}"    Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Bottom note -->
    <Border Background="#14080A" BorderBrush="#4B2325" BorderThickness="1" Padding="7,10">
      <TextBlock Text="Confirmed design: GUI is installed monitoring/review console; inspection runs in the background."
                 Foreground="#F27777" FontWeight="ExtraBold" TextAlignment="Center" FontSize="12"/>
    </Border>
  </StackPanel>
</UserControl>
