<UserControl x:Class="AOI_Monitor.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Main Inspection" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          <TextBlock Text="Operator inspection flow using imported or folder-simulated images. Camera, lighting, robot, and MES remain planned integrations."
                     Foreground="#8B969E" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Disposition" Margin="0,0,6,0" Click="OnOpenDispositionClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Golden Compare" Margin="0,0,6,0" Click="OnOpenCompareClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Image Library" Click="OnOpenLibraryClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.65*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <TextBlock x:Name="ImageStatusText" DockPanel.Dock="Right" Text="No image loaded" Foreground="#9AA6AF" FontSize="11"/>
              <TextBlock Text="Image / Simulated Live Feed" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </DockPanel>
          </Border>

          <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="View" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="ViewSelector" Width="110" SelectedIndex="0" SelectionChanged="OnViewSelectionChanged">
                <ComboBoxItem Content="Top"/>
                <ComboBoxItem Content="Side"/>
                <ComboBoxItem Content="Bottom"/>
              </ComboBox>
            </StackPanel>
            <CheckBox Grid.Column="2" x:Name="OverlayCheck" Content="Defect overlay layer" IsChecked="True"
                      VerticalAlignment="Center" Foreground="#DCE5EB" Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
              <Button Style="{StaticResource MiniBtn}" Content="Top Folder" Margin="0,0,6,0" Click="OnSelectTopFolderClick"/>
              <Button Style="{StaticResource MiniBtn}" Content="Side Folder" Margin="0,0,6,0" Click="OnSelectSideFolderClick"/>
              <Button Style="{StaticResource MiniBtn}" Content="Bottom Folder" Margin="0,0,6,0" Click="OnSelectBottomFolderClick"/>
              <CheckBox x:Name="AutoSaveCheck" Content="Auto-save" Foreground="#DCE5EB" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Margin="8,0,8,8" Background="#050607" BorderBrush="#343D44" BorderThickness="1">
            <Grid ClipToBounds="True">
              <TextBlock x:Name="EmptyImageText" Text="Select a folder or load an image from Image Library, then press Start / Next Board."
                         Foreground="#68757D" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
              <Viewbox Stretch="Uniform">
                <Grid x:Name="ImageOverlayRoot" Width="1000" Height="700">
                  <Image x:Name="InspectionImage" Stretch="Uniform"/>
                  <Canvas x:Name="DefectOverlayCanvas" Width="1000" Height="700" IsHitTestVisible="False"/>
                </Grid>
              </Viewbox>
            </Grid>
          </Border>

          <UniformGrid Grid.Row="3" Columns="4" Margin="8,0,8,8">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Start" Margin="0,0,6,0" Click="OnStartClick"/>
            <Button Style="{StaticResource ActionBtnRed}" Content="Stop" Margin="0,0,6,0" Click="OnStopClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Next Board" Margin="0,0,6,0" Click="OnNextBoardClick"/>
            <Button Style="{StaticResource ActionBtnAmber}" Content="Save Result" Click="OnSaveResultClick"/>
          </UniformGrid>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Board / Status" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="40"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Board / Model" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="BoardModelText" Text="TBOX-MAIN" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="Lot ID" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LotText" Text="POC-LOT" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Text="Operator" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OperatorText" Text="Engineer01" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Text="Engine" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EngineText" Text="Pixel Difference" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="4" Text="Status" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
              <Border Grid.Row="4" Grid.Column="1" x:Name="ResultStatusBorder" Style="{StaticResource ChipAmber}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="ResultStatusText" Text="WARNING" FontWeight="Bold" FontSize="11"/>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Defect List" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <DataGrid Grid.Row="1" x:Name="DefectGrid" ItemsSource="{Binding}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding No}" Width="44"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="70"/>
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="70"/>
                <DataGridTextColumn Header="X" Binding="{Binding XDisplay}" Width="58"/>
                <DataGridTextColumn Header="Y" Binding="{Binding YDisplay}" Width="58"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="25"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <TextBlock x:Name="ModeText" DockPanel.Dock="Right" Text="STOPPED" Foreground="#E1A334" FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="Alarm / Event Log" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="AlarmGrid" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="140"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
