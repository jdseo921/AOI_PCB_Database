<UserControl x:Class="AOI_Monitor.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AOI_Monitor.Controls"
             Background="#0B0E10">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">

      <!-- ══ KPI STRIP (6 cards) ══ -->
      <UniformGrid Columns="6">

        <!-- KPI 1 Total Library -->
        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Total Library" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="23,932" FontSize="22" FontWeight="ExtraBold" Foreground="#F2F7FA"/>
                <TextBlock Text="all indexed samples" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 37.1%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="37.1"
                GaugeColor="#50F56E" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <!-- KPI 2 NG Records -->
        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="NG Records" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="8,809" FontSize="22" FontWeight="ExtraBold" Foreground="#F2F7FA"/>
                <TextBlock Text="verified defect samples" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 84.6%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="84.6"
                GaugeColor="#50F56E" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <!-- KPI 3 Pending Review -->
        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Pending Review" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="462" FontSize="22" FontWeight="ExtraBold" Foreground="#F2F7FA"/>
                <TextBlock Text="operator disposition queue" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 66.7%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="66.7"
                GaugeColor="#50F56E" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <!-- KPI 4 Possible Escapes (RED) -->
        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Possible Escapes" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="36" FontSize="22" FontWeight="ExtraBold" Foreground="#F13B3F"/>
                <TextBlock Text="AI OK / GT NG cases" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 18.9%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="18.9"
                GaugeColor="#F13B3F" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <!-- KPI 5 False Calls (AMBER) -->
        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="False Calls" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="211" FontSize="22" FontWeight="ExtraBold" Foreground="#E1A334"/>
                <TextBlock Text="AI NG / GT OK cases" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 42.4%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="42.4"
                GaugeColor="#E1A334" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <!-- KPI 6 Linked Images -->
        <Border Style="{StaticResource Panel}" MinHeight="104">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Linked Images" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <Grid Grid.Row="1" Margin="7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="99.1%" FontSize="22" FontWeight="ExtraBold" Foreground="#F2F7FA"/>
                <TextBlock Text="image vault integrity" Foreground="#9FA9B1" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock Text="monitor: 99.1%" Foreground="#68757D" FontSize="9.5" Margin="0,3,0,0"/>
              </StackPanel>
              <c:CircularGauge Grid.Column="1" Value="99.1"
                GaugeColor="#50F56E" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>
      </UniformGrid>

      <!-- ══ PRODUCTION GRID ══ -->
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="1.25*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="1.45*"/>
        </Grid.ColumnDefinitions>

        <!-- Defect Mix -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Defect Mix by Category" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="8">
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Text="Solder" FontSize="11" Foreground="#8C98A1"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource BarTrack}" Value="48" Maximum="100" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="3,128" FontSize="11" Foreground="#8C98A1" TextAlignment="Right"/>
              </Grid>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Text="Component" FontSize="11" Foreground="#8C98A1"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource BarTrack}" Value="27" Maximum="100" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="2,144" FontSize="11" Foreground="#8C98A1" TextAlignment="Right"/>
              </Grid>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Text="Connector" FontSize="11" Foreground="#8C98A1"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource BarTrack}" Value="12" Maximum="100" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="1,048" FontSize="11" Foreground="#8C98A1" TextAlignment="Right"/>
              </Grid>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Text="Surface" FontSize="11" Foreground="#8C98A1"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource BarTrack}" Value="8" Maximum="100" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="966" FontSize="11" Foreground="#8C98A1" TextAlignment="Right"/>
              </Grid>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Text="Electrical" FontSize="11" Foreground="#8C98A1"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource BarTrack}" Value="5" Maximum="100" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="421" FontSize="11" Foreground="#8C98A1" TextAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Hourly Trend Chart -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Hourly Review Trend" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="8">
              <c:LineChart/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Rectangle Width="10" Height="3" Fill="#5CA0D3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBlock Text="Yield" Foreground="#89959D" FontSize="10.5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                  <Rectangle Width="10" Height="3" Fill="#E1A334" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBlock Text="False Calls" Foreground="#89959D" FontSize="10.5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="10" Height="3" Fill="#F13B3F" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBlock Text="Escapes" Foreground="#89959D" FontSize="10.5"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Recipe Status -->
        <Border Grid.Column="4" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Recipe / Engine Status" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="8">
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Recipe ID" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="TBOX_TOP_V1.2" FontSize="11.5"/>
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Board Program" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="TBOX-MAIN" FontSize="11.5"/>
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Camera Set" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="TOP/SIDE/BOTTOM" FontSize="11.5"/>
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Engine Version" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="Pixel Difference 0.1" FontSize="11.5"/>
              </Grid>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Revision Lock" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="LOCKED" Foreground="#C1FFCB" FontSize="11.5"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Owner" Foreground="#9AA6AF" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="ProcessEng01" FontSize="11.5"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ══ FOV STATION GRID ══ -->
      <Border Style="{StaticResource Panel}" Margin="0,8,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="FOV / Component Review Cells" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </Border>
          <UniformGrid Grid.Row="1" Columns="4" Margin="8" x:Name="StationsPanel"/>
        </Grid>
      </Border>

      <!-- Bottom alarm -->
      <Border Margin="0,8,0,0" Background="#14080A" BorderBrush="#4B2325" BorderThickness="1" Padding="7,10">
        <TextBlock Text="CAM05 status changed: possible escape review required -> 3 samples in process"
                   Foreground="#F27777" FontWeight="ExtraBold" TextAlignment="Center" FontSize="12"/>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
