<UserControl x:Class="AOI_Monitor.Views.PlannedStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}">
  <Grid Margin="8">
    <Border Style="{StaticResource Panel}" MaxWidth="680" MaxHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="32"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock x:Name="TitleText" Text="Planned Function" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="16">
          <TextBlock Text="PLANNED" Foreground="{DynamicResource HmiWarnBrush}" FontWeight="ExtraBold" FontSize="14" Margin="0,0,0,8"/>
          <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource HmiTextBodyBrush}" TextWrapping="Wrap" FontSize="14"/>
          <TextBlock Text="This area is intentionally disabled in the production-facing navigation until the backing workflow is implemented."
                     Foreground="{DynamicResource HmiTextLabelBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

