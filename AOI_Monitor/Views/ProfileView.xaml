<UserControl x:Class="AOI_Monitor.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="3D Profile Viewer" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
          <TextBlock Text="Sample Data Mode. CSV height-map review only. 3D Camera Not Connected."
                     Foreground="#E1A334" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="Source" Foreground="#9AA6AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="ProfileSourceCombo" Width="150" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="OnProfileSourceChanged">
            <ComboBoxItem Content="Sample CSV"/>
            <ComboBoxItem Content="Generic 3D Adapter (Real Hardware)"/>
            <ComboBoxItem Content="None"/>
          </ComboBox>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Load Height CSV" Margin="0,0,8,0" Click="OnLoadCsvClick"/>
          <Button x:Name="RunAcceptanceButton" Style="{StaticResource ActionBtnGreen}" Content="Run 3D Acceptance Test" Margin="0,0,8,0" Click="OnRunAcceptanceClick"/>
          <Button x:Name="CancelAcceptanceButton" Style="{StaticResource ActionBtnAmber}" Content="Cancel" Margin="0,0,8,0" Click="OnCancelAcceptanceClick" IsEnabled="False"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Export 3D Report" Margin="0,0,8,0" Click="OnExportAcceptanceClick"/>
          <Border Style="{StaticResource ChipAmber}" VerticalAlignment="Center">
            <TextBlock Text="Sample Data Mode" FontWeight="Bold" FontSize="14"/>
          </Border>
          <Border Style="{StaticResource ChipRed}" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="3D Camera Not Connected" FontWeight="Bold" FontSize="14"/>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.45*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <TextBlock x:Name="MapStatusText" DockPanel.Dock="Right" Text="No CSV loaded" Foreground="#9AA6AF" FontSize="14"/>
              <TextBlock Text="2D Color-Coded Height Map" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Margin="8" Background="#050607" BorderBrush="#343D44" BorderThickness="1">
            <Grid>
              <TextBlock x:Name="EmptyMapText" Text="Load a CSV with columns: x,y,height"
                         Foreground="#68757D" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
              <Image x:Name="HeightMapImage" Stretch="Uniform"
                     MouseLeftButtonDown="OnHeightMapClick"
                     MouseMove="OnHeightMapMouseMove"/>
              <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                      Background="#CC101519" BorderBrush="#4B5660" BorderThickness="1" Padding="8,6">
                <Grid Width="190">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel>
                    <TextBlock x:Name="LegendMaxText" DockPanel.Dock="Right" Text="--" Foreground="#DCE5EB" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Height Scale" Foreground="#9AA6AF" FontSize="14"/>
                  </DockPanel>
                  <Rectangle Grid.Row="1" Height="10" RadiusX="1" RadiusY="1">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#2850DC" Offset="0"/>
                        <GradientStop Color="#68C878" Offset="0.5"/>
                        <GradientStop Color="#FF5018" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <DockPanel Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock x:Name="LegendMinText" Text="--" Foreground="#DCE5EB" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="low to high" HorizontalAlignment="Center" Foreground="#7F8C95" FontSize="14" TextAlignment="Center"/>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Selected Defect Details" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
            </Border>
            <Grid Grid.Row="1" Margin="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="CSV" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="CsvNameText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
              <TextBlock Grid.Row="1" Text="Type" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DefectTypeText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Text="Height" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DefectHeightText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Text="Volume" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DefectVolumeText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="4" Text="X" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DefectXText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="5" Text="Y" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DefectYText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="6" Text="Height Min / Max" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="6" Grid.Column="1" x:Name="HeightRangeText" Text="--" Foreground="#DCE5EB" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="7" Text="Status" Foreground="#9AA6AF" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="7" Grid.Column="1" Text="Sample Data Mode only" Foreground="#E1A334" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Height Slice Profile" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
            </Border>
            <Canvas Grid.Row="1" x:Name="ProfileCanvas" Background="#050607" Margin="8"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <DockPanel Margin="8">
        <TextBlock x:Name="StatusText"
                   Text="Sample Data Mode. 3D Camera Not Connected. Stage 2 hardware integration required for live 3D profile inspection."
                   Foreground="#E1A334" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <ProgressBar x:Name="AcceptanceProgressBar" DockPanel.Dock="Right" Width="140" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Accept Defect" Margin="0,0,8,0" Click="OnAcceptDefectClick"/>
          <Button Style="{StaticResource ActionBtnRed}" Content="Reject Defect" Click="OnRejectDefectClick"/>
        </WrapPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

