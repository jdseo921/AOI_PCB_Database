<UserControl x:Class="AOI_Monitor.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">

      <!-- Top row: header + thresholds -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Program header -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Program Header" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <UniformGrid Grid.Row="1" Columns="2" Margin="8" Rows="3">
              <Border Style="{StaticResource FieldBox}" Margin="0,0,5,5"><StackPanel><TextBlock Text="Recipe ID" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="TBOX_TOP_V1.2" FontWeight="Bold" FontSize="12"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0,0,0,5"><StackPanel><TextBlock Text="Board Program" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="TBOX-MAIN" FontWeight="Bold" FontSize="12"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0,0,5,5"><StackPanel><TextBlock Text="Camera Set" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="TOP/SIDE/BOTTOM" FontWeight="Bold" FontSize="12"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0,0,0,5"><StackPanel><TextBlock Text="Inspection Engine" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="Pixel Difference 0.1" FontWeight="Bold" FontSize="12"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Revision Lock" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="LOCKED" FontWeight="Bold" Foreground="#C1FFCB" FontSize="12"/></StackPanel></Border>
              <Border Style="{StaticResource FieldBox}" Margin="0"><StackPanel><TextBlock Text="Owner" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,2"/><TextBlock Text="ProcessEng01" FontWeight="Bold" FontSize="12"/></StackPanel></Border>
            </UniformGrid>
          </Grid>
        </Border>

        <!-- Thresholds -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Threshold Set" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </Border>
            <DataGrid Grid.Row="1" x:Name="ThresholdGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Type"         Binding="{Binding Type}"      Width="*"/>
                <DataGridTextColumn Header="Threshold"    Binding="{Binding Threshold}" Width="75"/>
                <DataGridTextColumn Header="FN Priority"  Binding="{Binding FnMode}"    Width="80"/>
                <DataGridTextColumn Header="FP Reduction" Binding="{Binding FpMode}"    Width="85"/>
                <DataGridTextColumn Header="Status"       Binding="{Binding Status}"    Width="60"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <!-- Inspection matrix -->
      <Border Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Inspection Item Matrix" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </Border>
          <DataGrid Grid.Row="1" x:Name="MatrixGrid" MaxHeight="220">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Inspection Item" Binding="{Binding Item}"        Width="130"/>
              <DataGridTextColumn Header="Presence"        Binding="{Binding Presence}"    Width="*"/>
              <DataGridTextColumn Header="Polarity"        Binding="{Binding Polarity}"    Width="*"/>
              <DataGridTextColumn Header="Bridge"          Binding="{Binding Bridge}"      Width="*"/>
              <DataGridTextColumn Header="Coplanarity"     Binding="{Binding Coplanarity}" Width="*"/>
              <DataGridTextColumn Header="Volume"          Binding="{Binding Volume}"      Width="*"/>
              <DataGridTextColumn Header="Action"          Binding="{Binding Action}"      Width="1.5*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
