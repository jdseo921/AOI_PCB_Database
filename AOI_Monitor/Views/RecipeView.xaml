<UserControl x:Class="AOI_Monitor.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="155"/>
          <ColumnDefinition Width="155"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="Recipe ID" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
          <TextBox x:Name="RecipeNameText" Text="TBOX_TOP"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Text="Board Program" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
          <TextBlock x:Name="BoardProgramText" Text="TBOX-MAIN" FontWeight="Bold" Foreground="#DCE5EB" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,8,0">
          <TextBlock Text="Operator" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
          <TextBlock x:Name="OperatorText" Text="Engineer01" FontWeight="Bold" Foreground="#DCE5EB"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,8,0">
          <TextBlock Text="Revision Lock" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
          <TextBlock x:Name="LockStatusText" Text="UNLOCKED" FontWeight="Bold" Foreground="#C1FFCB"/>
        </StackPanel>
        <TextBlock Grid.Column="4" x:Name="RecipeStatusText" Text="Load a PCB image to start editing." Foreground="#9AA6AF" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
        <WrapPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Style="{StaticResource ActionBtn}" Content="Load Image" Margin="0,0,6,0" Click="OnLoadImageClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Test Run" Margin="0,0,6,0" Click="OnTestRunClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Save Recipe" Click="OnSaveRecipeClick"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <TextBlock x:Name="CanvasHintText" DockPanel.Dock="Right" Text="Drag to draw. Wheel zooms. Right-drag pans." Foreground="#8B969E" FontSize="10.5"/>
              <TextBlock Text="Recipe Background + ROI Editor" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
            </DockPanel>
          </Border>
          <WrapPanel Grid.Row="1" Margin="8">
            <Button Style="{StaticResource MiniBtn}" Content="Zoom -" Margin="0,0,6,0" Click="OnZoomOutClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Zoom +" Margin="0,0,6,0" Click="OnZoomInClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Fit" Margin="0,0,6,0" Click="OnFitClick"/>
            <TextBlock x:Name="ZoomText" Text="100%" Foreground="#DCE5EB" VerticalAlignment="Center"/>
          </WrapPanel>
          <Border Grid.Row="2" Margin="8" Background="#050607" BorderBrush="#343D44" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="ViewportCanvas"
                    Background="#050607"
                    Focusable="True"
                    MouseLeftButtonDown="OnCanvasLeftDown"
                    MouseLeftButtonUp="OnCanvasLeftUp"
                    MouseMove="OnCanvasMouseMove"
                    MouseRightButtonDown="OnCanvasRightDown"
                    MouseRightButtonUp="OnCanvasRightUp"
                    MouseWheel="OnCanvasMouseWheel"
                    KeyDown="OnCanvasKeyDown">
              <Canvas.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                  <TranslateTransform x:Name="CanvasPan" X="0" Y="0"/>
                </TransformGroup>
              </Canvas.RenderTransform>
              <Image x:Name="RecipeImage" Stretch="None"/>
              <Canvas x:Name="RoiCanvas" Background="Transparent"/>
            </Canvas>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="185"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="ROI Setup" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </Border>

          <DataGrid Grid.Row="1" x:Name="RoiGrid" SelectionChanged="OnRoiSelectionChanged" CanUserSortColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Binding="{Binding RoiType}" Width="115"/>
              <DataGridTextColumn Header="AI" Binding="{Binding AiScoreThreshold}" Width="55"/>
              <DataGridTextColumn Header="X" Binding="{Binding X}" Width="55"/>
              <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="55"/>
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="2" Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
              <TextBlock Text="ROI Type" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <ComboBox x:Name="RoiTypeCombo" SelectionChanged="OnRoiParameterChanged">
                <ComboBoxItem Content="Presence"/>
                <ComboBoxItem Content="Polarity"/>
                <ComboBoxItem Content="Solder Bridge"/>
                <ComboBoxItem Content="Height"/>
                <ComboBoxItem Content="Anomaly"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
              <TextBlock Text="AI Score Threshold" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <TextBox x:Name="AiThresholdText" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="Height Min" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <TextBox x:Name="HeightMinText" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0">
              <TextBlock Text="Height Max" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <TextBox x:Name="HeightMaxText" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="Volume Min" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <TextBox x:Name="VolumeMinText" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0">
              <TextBlock Text="Volume Max" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
              <TextBox x:Name="VolumeMaxText" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <WrapPanel Grid.Row="6" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
              <Button Style="{StaticResource ActionBtnRed}" Content="Delete ROI" Click="OnDeleteRoiClick"/>
            </WrapPanel>
          </Grid>

          <StackPanel Grid.Row="3" Margin="8">
            <TextBlock Text="Revision Notes" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,3"/>
            <TextBlock x:Name="RevisionText" Text="No saved revision loaded." Foreground="#DCE5EB" TextWrapping="Wrap" FontSize="11.5"/>
            <TextBlock Text="Active ROI is yellow. Saved ROI is green. Unsaved ROI is blue." Foreground="#8B969E" TextWrapping="Wrap" FontSize="10.5" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
