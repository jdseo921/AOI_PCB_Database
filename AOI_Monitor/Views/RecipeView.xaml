<UserControl x:Class="AOI_Monitor.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <WrapPanel Margin="8">
        <StackPanel Style="{StaticResource HmiAdaptiveFilterField}" Width="170">
          <TextBlock Text="Recipe ID" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
          <TextBox x:Name="RecipeNameText" AutomationProperties.Name="Recipe ID" Text="TBOX_TOP"/>
        </StackPanel>
        <StackPanel Style="{StaticResource HmiAdaptiveFilterField}" Width="170">
          <TextBlock Text="Board Program" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
          <TextBlock x:Name="BoardProgramText" Text="TBOX-MAIN" FontWeight="Bold" Foreground="#DCE5EB" VerticalAlignment="Center" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource HmiAdaptiveFilterField}" Width="155">
          <TextBlock Text="Operator" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
          <TextBlock x:Name="OperatorText" Text="Engineer01" FontWeight="Bold" Foreground="#DCE5EB" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource HmiAdaptiveFilterField}" Width="155">
          <TextBlock Text="Revision Lock" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
          <TextBlock x:Name="LockStatusText" Text="UNLOCKED" FontWeight="Bold" Foreground="#C1FFCB"/>
        </StackPanel>
        <TextBlock x:Name="RecipeStatusText" Text="Load a PCB image to start editing." Foreground="#9AA6AF" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="360" Margin="{StaticResource HmiFieldGap}"/>
        <WrapPanel VerticalAlignment="Bottom" Style="{StaticResource HmiInlineActionBand}">
          <Button Style="{StaticResource ActionBtn}" Content="Load Image" Margin="{StaticResource HmiButtonGap}" Click="OnLoadImageClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Test Run" Margin="{StaticResource HmiButtonGap}" Click="OnTestRunClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Save Recipe" Margin="{StaticResource HmiButtonGap}" Click="OnSaveRecipeClick"/>
        </WrapPanel>
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <TextBlock x:Name="CanvasHintText" DockPanel.Dock="Right" Text="Drag to draw. Wheel zooms. Right-drag pans." Foreground="#8B969E" FontSize="14"/>
              <TextBlock Text="Recipe Background + ROI Editor" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
            </DockPanel>
          </Border>
          <WrapPanel Grid.Row="1" Margin="8" Style="{StaticResource HmiInlineActionBand}">
            <Button Style="{StaticResource MiniBtn}" Content="Zoom -" Margin="{StaticResource HmiButtonGap}" Click="OnZoomOutClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Zoom +" Margin="{StaticResource HmiButtonGap}" Click="OnZoomInClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Fit" Margin="{StaticResource HmiButtonGap}" Click="OnFitClick"/>
            <TextBlock x:Name="ZoomText" Text="100%" Foreground="#DCE5EB" VerticalAlignment="Center"/>
          </WrapPanel>
          <Border Grid.Row="2" Margin="8" Background="#050607" BorderBrush="#343D44" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Canvas x:Name="ViewportCanvas"
                      Background="#050607"
                      Focusable="True"
                      MouseLeftButtonDown="OnCanvasLeftDown"
                      MouseLeftButtonUp="OnCanvasLeftUp"
                      MouseMove="OnCanvasMouseMove"
                      MouseRightButtonDown="OnCanvasRightDown"
                      MouseRightButtonUp="OnCanvasRightUp"
                      MouseWheel="OnCanvasMouseWheel"
                      KeyDown="OnCanvasKeyDown">
                <Canvas.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CanvasPan" X="0" Y="0"/>
                  </TransformGroup>
                </Canvas.RenderTransform>
                <Image x:Name="RecipeImage" Stretch="None"/>
                <Canvas x:Name="RoiCanvas" Background="Transparent"/>
              </Canvas>
              <Border x:Name="RecipeEmptyStateCard"
                      Style="{StaticResource HmiEmptyStateCard}"
                      Width="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
                <StackPanel>
                  <TextBlock Text="No board image loaded" Style="{StaticResource HmiStateTitleText}" TextAlignment="Center"/>
                  <TextBlock Text="Use Load Image to place a PCB image here, then draw ROI masks and tolerance rules."
                             Style="{StaticResource HmiStateNextActionText}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="ROI Setup" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
          </Border>

          <DataGrid Grid.Row="1" x:Name="RoiGrid" SelectionChanged="OnRoiSelectionChanged" CanUserSortColumns="True" Style="{StaticResource HmiTable}" MinWidth="0" MaxHeight="180">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Binding="{Binding RoiType}" Width="140" MinWidth="140"/>
              <DataGridTextColumn Header="AI" Binding="{Binding AiScoreThreshold}" Width="80" MinWidth="80" HeaderTemplate="{StaticResource HmiHeaderInspectionResultTemplate}"/>
              <DataGridTextColumn Header="X" Binding="{Binding X}" Width="80" MinWidth="80"/>
              <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="80" MinWidth="80"/>
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="2" Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
              <TextBlock Text="ROI Type" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <ComboBox x:Name="RoiTypeCombo" AutomationProperties.Name="ROI type" SelectionChanged="OnRoiParameterChanged">
                <ComboBoxItem Content="Presence"/>
                <ComboBoxItem Content="Polarity"/>
                <ComboBoxItem Content="Placement"/>
                <ComboBoxItem Content="Solder Bridge"/>
                <ComboBoxItem Content="Solder Volume"/>
                <ComboBoxItem Content="Height"/>
                <ComboBoxItem Content="Surface Defect"/>
                <ComboBoxItem Content="Anomaly"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
              <TextBlock Text="AI Score Threshold" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <TextBox x:Name="AiThresholdText" AutomationProperties.Name="AI score threshold" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="Height Min" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <TextBox x:Name="HeightMinText" AutomationProperties.Name="Height minimum" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0">
              <TextBlock Text="Height Max" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <TextBox x:Name="HeightMaxText" AutomationProperties.Name="Height maximum" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="Volume Min" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <TextBox x:Name="VolumeMinText" AutomationProperties.Name="Volume minimum" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0">
              <TextBlock Text="Volume Max" Foreground="#7F8C95" FontSize="14" Margin="0,0,0,3"/>
              <TextBox x:Name="VolumeMaxText" AutomationProperties.Name="Volume maximum" TextChanged="OnRoiParameterChanged"/>
            </StackPanel>
            <WrapPanel Grid.Row="6" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
              <Button Style="{StaticResource ActionBtnRed}" Content="Delete ROI" Click="OnDeleteRoiClick"/>
            </WrapPanel>
          </Grid>

          <ScrollViewer Grid.Row="3" Margin="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Processing &amp; Tolerance Rules" Foreground="#7F8C95" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="X/Y tolerance mm" Foreground="#9AA6AF" FontSize="14"/>
                  <TextBox x:Name="PlacementToleranceText" Text="0.020" MinHeight="34" AutomationProperties.Name="X/Y placement tolerance millimeters" ToolTip="Dimensional tolerance for placement offset evidence."/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                  <TextBlock Text="Rotation tolerance deg" Foreground="#9AA6AF" FontSize="14"/>
                  <TextBox x:Name="RotationToleranceText" Text="1.0" MinHeight="34" AutomationProperties.Name="Rotation tolerance degrees" ToolTip="Skew tolerance for component placement evidence."/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="IPC acceptability class" Foreground="#9AA6AF" FontSize="14"/>
                  <ComboBox x:Name="IpcClassCombo" SelectedIndex="1" MinHeight="34" AutomationProperties.Name="IPC acceptability class">
                    <ComboBoxItem Content="IPC Class 1"/>
                    <ComboBoxItem Content="IPC Class 2"/>
                    <ComboBoxItem Content="IPC Class 3"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="Lighting profile" Foreground="#9AA6AF" FontSize="14"/>
                  <ComboBox x:Name="LightingProfileCombo" SelectedIndex="0" MinHeight="34" AutomationProperties.Name="Lighting profile">
                    <ComboBoxItem Content="Top bright field"/>
                    <ComboBoxItem Content="Low-angle dark field"/>
                    <ComboBoxItem Content="Side marking light"/>
                    <ComboBoxItem Content="Solder fillet highlight"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                  <TextBlock Text="False-call policy" Foreground="#9AA6AF" FontSize="14"/>
                  <ComboBox x:Name="FalseCallPolicyCombo" SelectedIndex="1" MinHeight="34" AutomationProperties.Name="False-call policy">
                    <ComboBoxItem Content="Strict: hold every suspected defect"/>
                    <ComboBoxItem Content="Balanced: review benign visual noise"/>
                    <ComboBoxItem Content="Sensitive: reduce possible escapes"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Text="Revision Notes" Foreground="#7F8C95" FontSize="14" FontWeight="Bold" Margin="0,12,0,3"/>
              <TextBlock x:Name="RevisionText" Text="No saved revision loaded." Foreground="#DCE5EB" TextWrapping="Wrap" FontSize="14"/>
              <TextBlock Text="Active ROI is yellow. Saved ROI is green. Unsaved ROI is blue. Stage 1 evidence remains image-based until real camera, lighting, robot, and MES acceptance records exist."
                         Foreground="#8B969E" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

