<UserControl x:Class="AOI_Monitor.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Log Filters" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
        </Border>
        <Grid Grid.Row="1" Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="From" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <DatePicker x:Name="FromDatePicker"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="To" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <DatePicker x:Name="ToDatePicker"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Model / Board" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="BoardFilterText" Text=""/>
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Text="Operator" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="OperatorFilterText" Text=""/>
          </StackPanel>
          <StackPanel Grid.Column="8">
            <TextBlock Text="Result" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="ResultFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL"/>
              <ComboBoxItem Content="OK"/>
              <ComboBoxItem Content="REVIEW"/>
              <ComboBoxItem Content="NG"/>
            </ComboBox>
          </StackPanel>
          <WrapPanel Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Apply Filters" Margin="0,0,6,0" Click="OnApplyFiltersClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Clear" Click="OnClearFiltersClick"/>
          </WrapPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
            <TextBlock Text="User Role" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="RoleFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL"/>
              <ComboBoxItem Content="Operator"/>
              <ComboBoxItem Content="Engineer"/>
              <ComboBoxItem Content="Admin"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock Text="Audit Action Type" Foreground="#9AA6AF" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="ActionTypeFilterText" Text="" ToolTip="Examples: LOGIN, EXPORT, MAIN_INSPECTION, ENGINE_CONFIG, CALIBRATION"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="5" Text="Audit Trail filters apply user, role, date, and action type for QC documentation."
                     Foreground="#8B969E" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,8,0,3"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <TextBlock x:Name="LogSummaryText" DockPanel.Dock="Right" Text="No records loaded" Foreground="#9AA6AF" FontSize="11"/>
            <TextBlock Text="SQLite Logs" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
          </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Background="#151A1E" BorderBrush="#343D44">
          <TabItem Header="Inspection History">
            <DataGrid x:Name="InspectionGrid" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Board" Binding="{Binding BoardProgram}" Width="110"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="90"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Verdict}" Width="70"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" SortMemberPath="DifferenceScore" Width="65"/>
                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" SortMemberPath="Confidence" Width="82"/>
                <DataGridTextColumn Header="Engine" Binding="{Binding InspectionEngine}" Width="140"/>
                <DataGridTextColumn Header="Defect" Binding="{Binding SuggestedDefect}" Width="150"/>
                <DataGridTextColumn Header="Image" Binding="{Binding ImageName}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Review / Disposition Events">
            <DataGrid x:Name="ReviewGrid" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="EventTimeUtc" Width="125"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="90"/>
                <DataGridTextColumn Header="Disposition" Binding="{Binding Disposition}" Width="110"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Export History">
            <DataGrid x:Name="ExportGrid" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ExportType}" Width="160"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                <DataGridTextColumn Header="Verify" Binding="{Binding VerificationStatus}" Width="70"/>
                <DataGridTextColumn Header="SHA-256" Binding="{Binding VerificationShaDisplay}" Width="100"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="130"/>
                <DataGridTextColumn Header="Audit ID" Binding="{Binding AuditEventDisplay}" Width="80"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Audit Trail">
            <DataGrid x:Name="AuditGrid" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC Time" Binding="{Binding TimestampUtcDisplay}" SortMemberPath="TimestampUtc" Width="140"/>
                <DataGridTextColumn Header="Local Time" Binding="{Binding LocalTimestampDisplay}" Width="140"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="105"/>
                <DataGridTextColumn Header="Role" Binding="{Binding UserRole}" Width="80"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="95"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionCategory}" Width="140"/>
                <DataGridTextColumn Header="Related ID" Binding="{Binding RelatedEntityDisplay}" Width="145"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding ActionDetail}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="MES Queue">
            <DataGrid x:Name="MesSpoolGrid" CanUserSortColumns="True" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Type" Binding="{Binding PayloadType}" Width="135"/>
                <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="100"/>
                <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="105"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointUrl}" Width="150"/>
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="75"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Central Sync Queue">
            <DataGrid x:Name="CentralSyncGrid" CanUserSortColumns="True" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Item Type" Binding="{Binding ItemType}" Width="145"/>
                <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="85"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="115"/>
                <DataGridTextColumn Header="Endpoint/Folder" Binding="{Binding EndpointOrFolder}" Width="150"/>
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="75"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Factory Readiness">
            <DataGrid x:Name="FactoryReadinessGrid" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                <DataGridTextColumn Header="Next Action" Binding="{Binding NextAction}" Width="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Factory Acceptance">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="Deployment Profile" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="FactoryAcceptanceProfileCombo" Width="230" SelectedIndex="0" Style="{StaticResource FilterCombo}"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Generate Checklist" Margin="8,0,0,0" Click="OnGenerateFactoryAcceptanceChecklistClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Export FAT Package" Margin="8,0,0,0" Click="OnExportFactoryAcceptanceChecklistClick"/>
              </StackPanel>
              <DataGrid x:Name="FactoryAcceptanceGrid" Grid.Row="1" CanUserSortColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding RequirementId}" Width="95"/>
                  <DataGridTextColumn Header="Requirement" Binding="{Binding Requirement}" Width="220"/>
                  <DataGridTextColumn Header="Expected Evidence" Binding="{Binding ExpectedEvidence}" Width="240"/>
                  <DataGridTextColumn Header="Evidence Path" Binding="{Binding CurrentEvidencePath}" Width="190"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                  <DataGridTextColumn Header="Operator" Binding="{Binding OperatorSignoff}" Width="90"/>
                  <DataGridTextColumn Header="Engineer" Binding="{Binding EngineerSignoff}" Width="90"/>
                  <DataGridTextColumn Header="Admin" Binding="{Binding AdminSignoff}" Width="90"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Auto-Archive Policy" Foreground="#9AA6AF" FontSize="10" Margin="0,0,0,3"/>
          <TextBlock x:Name="ArchivePolicyText"
                     Text="Logs older than 30 days are copied into LogArchive during startup. Source rows remain in place, so the archive is reversible and audit-safe."
                     TextWrapping="Wrap" FontSize="11.5" Foreground="#DCE5EB"/>
          <TextBlock x:Name="StatusText" Text="Ready." Foreground="#9AA6AF" FontSize="11" Margin="0,6,0,0"/>
          <TextBlock x:Name="PackagePathText" Text="Latest customer package: --" Foreground="#DCE5EB" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SoakReportPathText" Text="Latest soak-test report: --" Foreground="#DCE5EB" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BuildEvidenceSummaryText" Text="Build/test evidence: --" Foreground="#DCE5EB" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ProgressBar x:Name="WorkProgressBar" Width="190" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelWorkButton" Style="{StaticResource MiniBtn}" Content="Cancel" IsEnabled="False" Click="OnCancelWorkClick"/>
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
          <Button Style="{StaticResource ActionBtnGreen}" Content="Inspection History CSV" Margin="0,0,6,6" Click="OnExportInspectionHistoryClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Review Log CSV" Margin="0,0,6,6" Click="OnExportReviewLogClick"/>
          <Button Style="{StaticResource ActionBtnGreen}" Content="Audit Trail CSV" Margin="0,0,6,6" Click="OnExportAuditTrailClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Annotated Overlays" Margin="0,0,6,6" Click="OnExportAnnotatedOverlaysClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Create Stage 1 Customer Package" Margin="0,0,6,6" Click="OnExportCustomerPackageClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Export Go/No-Go Package" Margin="0,0,6,6" Click="OnExportFactoryReadinessPackageClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Export FAT Checklist" Margin="0,0,6,6" Click="OnExportFactoryAcceptanceChecklistClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Import Build/Test Evidence" Margin="0,0,6,6" Click="OnImportBuildTestEvidenceClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Open Build Evidence Folder" Margin="0,0,6,6" Click="OnOpenBuildEvidenceFolderClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="DB Integrity" Margin="0,0,6,0" Click="OnRunDbIntegrityCheckClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Database Health" Margin="0,0,6,0" Click="OnOpenDatabaseHealthClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Verify Paths" Margin="0,0,6,0" Click="OnVerifyImagePathsClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Verify Selected Export" Margin="0,0,6,0" Click="OnVerifySelectedExportClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Rebuild Image Index" Margin="0,0,6,0" Click="OnRebuildImageIndexClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Upload Result to MES" Margin="0,0,6,0" Click="OnUploadMesMockClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Run Traceability Test" Margin="0,0,6,0" Click="OnRunTraceabilityTestClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected MES" Margin="0,0,6,0" Click="OnRetrySelectedMesSpoolClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Pending MES" Margin="0,0,6,0" Click="OnRetryMesSpoolClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Export Queue Report" Margin="0,0,6,0" Click="OnExportMesQueueReportClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Mark MES Abandoned" Margin="0,0,6,0" Click="OnAbandonMesSpoolClick"/>
          <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Central Sync" Margin="0,0,6,0" Click="OnQueueCentralSyncClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected Central" Margin="0,0,6,0" Click="OnRetrySelectedCentralSyncClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Central" Margin="0,0,6,0" Click="OnRetryCentralSyncClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Export Central Sync Report" Margin="0,0,6,0" Click="OnExportCentralSyncReportClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Soak Test" Margin="0,0,6,0" Click="OnRunSoakTestClick"/>
          <Button Style="{StaticResource ActionBtn}" Content="Export Latest Soak Evidence" Margin="0,0,6,0" Click="OnExportLatestSoakEvidenceClick"/>
          <Button Style="{StaticResource ActionBtnAmber}" Content="Lock Recipe" Click="OnLockActiveRecipeClick"/>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
