<UserControl x:Class="AOI_Monitor.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:AOI_Monitor.Services"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Log Filters" Style="{StaticResource HmiSectionHeaderText}"/>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="128">
          <WrapPanel>
          <StackPanel Width="132" Margin="0,0,8,8">
            <TextBlock Text="From" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <DatePicker x:Name="FromDatePicker"/>
          </StackPanel>
          <StackPanel Width="132" Margin="0,0,8,8">
            <TextBlock Text="To" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <DatePicker x:Name="ToDatePicker"/>
          </StackPanel>
          <StackPanel Width="170" Margin="0,0,8,8">
            <TextBlock Text="Model / Board" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <TextBox x:Name="BoardFilterText" Text=""/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,8,8">
            <TextBlock Text="Operator" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <TextBox x:Name="OperatorFilterText" Text=""/>
          </StackPanel>
          <StackPanel Width="132" Margin="0,0,8,8">
            <TextBlock Text="Result" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <ComboBox x:Name="ResultFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL"/>
              <ComboBoxItem Content="OK"/>
              <ComboBoxItem Content="REVIEW"/>
              <ComboBoxItem Content="NG"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,8,8">
            <TextBlock Text="User Role" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <ComboBox x:Name="RoleFilterCombo" SelectedIndex="0">
              <ComboBoxItem Content="ALL"/>
              <ComboBoxItem Content="Operator"/>
              <ComboBoxItem Content="Engineer"/>
              <ComboBoxItem Content="Admin"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="270" Margin="0,0,8,8">
            <TextBlock Text="Audit Action Type" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
            <TextBox x:Name="ActionTypeFilterText" Text="" ToolTip="Examples: LOGIN, EXPORT, MAIN_INSPECTION, ENGINE_CONFIG, CALIBRATION"/>
          </StackPanel>
          <WrapPanel Width="282" VerticalAlignment="Bottom" Margin="0,18,8,8">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Apply Filters" Margin="0,0,6,0" Click="OnApplyFiltersClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Clear" Click="OnClearFiltersClick"/>
          </WrapPanel>
          <TextBlock Width="520"
                     Text="Filter production evidence, operator decisions, exports, and queue activity. Long paths are available through hover tooltips."
                     Style="{StaticResource HmiPageSubtitleText}"
                     VerticalAlignment="Bottom"
                     Margin="0,18,0,8"/>
          </WrapPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <TextBlock x:Name="LogSummaryText" DockPanel.Dock="Right" Text="No records loaded" Foreground="#9AA6AF" FontSize="14"/>
            <TextBlock Text="SQLite Logs" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="14"/>
          </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Background="#151A1E" BorderBrush="#343D44">
          <TabItem Header="Inspection History">
            <DataGrid x:Name="InspectionGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Board" Binding="{Binding BoardProgram}" Width="110"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="90"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Verdict}" Width="70"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" SortMemberPath="DifferenceScore" Width="65"/>
                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" SortMemberPath="Confidence" Width="82"/>
                <DataGridTextColumn Header="Engine" Binding="{Binding InspectionEngine}" Width="140"/>
                <DataGridTextColumn Header="Defect" Binding="{Binding SuggestedDefect}" Width="150"/>
                <DataGridTextColumn Header="Image" Binding="{Binding ImageName}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Review / Disposition Events">
            <DataGrid x:Name="ReviewGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="EventTimeUtc" Width="125"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="90"/>
                <DataGridTextColumn Header="Disposition" Binding="{Binding Disposition}" Width="110"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Export History">
            <DataGrid x:Name="ExportGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="Export file paths are available through row/cell hover when truncated.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ExportType}" Width="160"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                <DataGridTextColumn Header="Verify" Binding="{Binding VerificationStatus}" Width="70"/>
                <DataGridTextColumn Header="SHA-256" Binding="{Binding VerificationShaDisplay}" Width="100"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorId}" Width="130"/>
                <DataGridTextColumn Header="Audit ID" Binding="{Binding AuditEventDisplay}" Width="80"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Audit Trail">
            <DataGrid x:Name="AuditGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="Traceability means the audit path from user, board, result, export, and upload event.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC Time" Binding="{Binding TimestampUtcDisplay}" SortMemberPath="TimestampUtc" Width="140"/>
                <DataGridTextColumn Header="Local Time" Binding="{Binding LocalTimestampDisplay}" Width="140"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="105"/>
                <DataGridTextColumn Header="Role" Binding="{Binding UserRole}" Width="80"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="95"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionCategory}" Width="140"/>
                <DataGridTextColumn Header="Related ID" Binding="{Binding RelatedEntityDisplay}" Width="145"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding ActionDetail}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="MES Upload Queue" ToolTip="MES means factory traceability system. This queue shows results waiting to upload, failed uploads, and sent records.">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Status" Foreground="#8B969E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MesQueueStatusFilter" Width="150" SelectionChanged="OnMesQueueStatusFilterChanged" SelectedIndex="0">
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="Pending"/>
                  <ComboBoxItem Content="Failed"/>
                  <ComboBoxItem Content="Sent"/>
                  <ComboBoxItem Content="Abandoned"/>
                </ComboBox>
              </StackPanel>
              <DataGrid x:Name="MesSpoolGrid" CanUserSortColumns="True" SelectionMode="Extended" Style="{StaticResource HmiTable}" ToolTip="Endpoint and last-error text may be long; hover the row/cell to inspect the full value.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding PayloadType}" Width="135"/>
                  <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="100"/>
                  <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="105"/>
                  <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                  <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointUrl}" Width="150"/>
                  <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="75"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                  <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Central Evidence Sync" ToolTip="Central Sync copies selected evidence to a configured folder or service. It does not approve factory readiness by itself.">
            <DataGrid x:Name="CentralSyncGrid" CanUserSortColumns="True" SelectionMode="Extended" Style="{StaticResource HmiTable}" ToolTip="Endpoint/folder summaries are intentionally compact; hover to inspect the full path or endpoint.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                <DataGridTextColumn Header="Item Type" Binding="{Binding ItemType}" Width="145"/>
                <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="85"/>
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="115"/>
                <DataGridTextColumn Header="Endpoint/Folder" Binding="{Binding EndpointOrFolder}" Width="150"/>
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryDisplay}" Width="75"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Pilot Issues">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Category" Foreground="#9AA6AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PilotIssueCategoryFilterCombo" Width="145" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="OnPilotIssueFilterChanged"/>
                <TextBlock Text="Status" Foreground="#9AA6AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PilotIssueStatusFilterCombo" Width="125" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="OnPilotIssueFilterChanged"/>
                <TextBlock Text="Severity" Foreground="#9AA6AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PilotIssueSeverityFilterCombo" Width="115" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="OnPilotIssueFilterChanged">
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="Critical"/>
                  <ComboBoxItem Content="High"/>
                  <ComboBoxItem Content="Medium"/>
                  <ComboBoxItem Content="Low"/>
                </ComboBox>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Good Board Marked Defect" Margin="0,0,6,0" Click="OnCreateFalseCallIssueClick" ToolTip="False Call: the system marked a good board as a defect."/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Possible Missed Defect" Margin="0,0,6,0" Click="OnCreatePossibleEscapeIssueClick" ToolTip="Possible Escape: the system may have missed a real defect."/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Refresh Issues" Margin="0,0,6,0" Click="OnRefreshPilotIssuesClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Close Selected" Margin="0,0,6,0" Click="OnClosePilotIssueClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Issue Report" Click="OnExportPilotIssueReportClick"/>
                <TextBlock x:Name="PilotIssueSummaryText" Text="Pilot issues not loaded." Foreground="#DCE5EB" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </WrapPanel>
              <DataGrid x:Name="PilotIssuesGrid" Grid.Row="1" CanUserSortColumns="True" SelectionMode="Single" Style="{StaticResource HmiTable}" ToolTip="Use this list to close manual test findings before a client demo. False Call means a good board was marked defect. Possible Escape means a real defect may have been missed.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding IssueId}" Width="135"/>
                  <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal}" SortMemberPath="CreatedAtUtc" Width="125"/>
                  <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115"/>
                  <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                  <DataGridTextColumn Header="Page" Binding="{Binding PageName}" Width="135"/>
                  <DataGridTextColumn Header="Steps" Binding="{Binding ReproductionSteps}" Width="190"/>
                  <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedBehavior}" Width="180"/>
                  <DataGridTextColumn Header="Actual" Binding="{Binding ActualBehavior}" Width="180"/>
                  <DataGridTextColumn Header="Evidence" Binding="{Binding ScreenshotPath}" Width="160"/>
                  <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="105"/>
                  <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="95"/>
                  <DataGridTextColumn Header="Inspection" Binding="{Binding RelatedInspectionId}" Width="90"/>
                  <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="110"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="UI Stability Test" ToolTip="Cycles through major screens to catch slow navigation, memory growth, and recoverable crashes.">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Profile" Foreground="#9AA6AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="UiStabilityProfileCombo" Width="235" SelectedIndex="1" Margin="0,0,8,0">
                  <ComboBoxItem Content="5-minute smoke" Tag="{x:Static services:UiNavigationSoakProfile.FiveMinuteSmoke}"/>
                  <ComboBoxItem Content="30-minute local stability" Tag="{x:Static services:UiNavigationSoakProfile.ThirtyMinuteLocalStability}"/>
                  <ComboBoxItem Content="4-hour client demo readiness" Tag="{x:Static services:UiNavigationSoakProfile.FourHourClientDemoReadiness}"/>
                  <ComboBoxItem Content="8-hour factory PoC" Tag="{x:Static services:UiNavigationSoakProfile.EightHourFactoryPoC}"/>
                </ComboBox>
                <CheckBox x:Name="UiStabilityHeavyLoadsCheck" Content="Exercise heavy page loads" Foreground="#DCE5EB" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Run UI Stability Test" Margin="0,0,6,0" Click="OnRunUiStabilityTestClick"/>
              </WrapPanel>
              <TextBlock Grid.Row="1" x:Name="UiStabilityStatsText"
                         Text="UI stability not run. Use 30-minute or better PASS evidence before client demo export."
                         Foreground="#DCE5EB" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <DataGrid Grid.Row="2" x:Name="UiStabilityEventsGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc}" Width="145"/>
                  <DataGridTextColumn Header="Cycle" Binding="{Binding Cycle}" Width="65"/>
                  <DataGridTextColumn Header="Page" Binding="{Binding PageName}" Width="170"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                  <DataGridTextColumn Header="Load ms" Binding="{Binding PageLoadMilliseconds}" Width="85"/>
                  <DataGridTextColumn Header="Heartbeat ms" Binding="{Binding HeartbeatMilliseconds}" Width="105"/>
                  <DataGridTextColumn Header="Memory MB" Binding="{Binding WorkingSetMegabytes}" Width="95"/>
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="Management Dashboard" ToolTip="Engineer/Admin view for trend review. Operators use Main Inspection for normal work.">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="165"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Lot" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
                  <TextBox x:Name="ManagementLotFilterText"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Model Version" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
                  <TextBox x:Name="ManagementModelFilterText"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Board / Operator" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
                  <TextBlock Text="Uses top filters" Foreground="#DCE5EB" FontSize="14" VerticalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                  <TextBlock Text="Deployment Profile" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,4"/>
                  <ComboBox x:Name="ManagementDeploymentProfileCombo" SelectedIndex="0" Style="{StaticResource FilterCombo}"/>
                </StackPanel>
                <WrapPanel Grid.Column="8" VerticalAlignment="Bottom">
                  <Button Style="{StaticResource ActionBtnGreen}" Content="Refresh Dashboard" Margin="0,0,6,0" Click="OnRefreshManagementDashboardClick"/>
                  <Button Style="{StaticResource ActionBtnAmber}" Content="Export Dashboard HTML/CSV/PDF" Click="OnExportManagementDashboardClick"/>
                </WrapPanel>
              </Grid>
              <TextBlock Grid.Row="1" x:Name="ManagementDashboardSummaryText" Text="Dashboard not loaded." Foreground="#DCE5EB" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,8"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="ManagementDefectGrid" Grid.Row="0" Grid.Column="0" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="False calls are OK boards flagged for review or NG. Escapes are known NG boards that may be missed.">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Defect Class" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                    <DataGridTextColumn Header="False Calls" Binding="{Binding FalseCalls}" Width="90"/>
                    <DataGridTextColumn Header="Escapes" Binding="{Binding PossibleEscapes}" Width="80"/>
                    <DataGridTextColumn Header="Reviews" Binding="{Binding Reviews}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ManagementRoiGrid" Grid.Row="0" Grid.Column="2" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="ROI means region of interest: the board image area checked for a defect.">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ROI / RefDes" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                    <DataGridTextColumn Header="False Calls" Binding="{Binding FalseCalls}" Width="90"/>
                    <DataGridTextColumn Header="Escapes" Binding="{Binding PossibleEscapes}" Width="80"/>
                    <DataGridTextColumn Header="Reviews" Binding="{Binding Reviews}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ManagementModelTrendGrid" Grid.Row="2" Grid.Column="0" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Model Version" Binding="{Binding ModelVersion}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70"/>
                    <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="60"/>
                    <DataGridTextColumn Header="NG" Binding="{Binding Ng}" Width="60"/>
                    <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="70"/>
                    <DataGridTextColumn Header="Avg ms" Binding="{Binding AverageInspectionTimeMs}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ManagementLotModelGrid" Grid.Row="2" Grid.Column="2" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="False-call rate and possible escapes are review signals, not automatic production release decisions.">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Lot" Binding="{Binding LotId}" Width="95"/>
                    <DataGridTextColumn Header="Board" Binding="{Binding BoardModel}" Width="105"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding ModelVersion}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="65"/>
                    <DataGridTextColumn Header="False Calls" Binding="{Binding FalseCalls}" Width="90"/>
                    <DataGridTextColumn Header="Escapes" Binding="{Binding PossibleEscapes}" Width="80"/>
                    <DataGridTextColumn Header="False-call Rate" Binding="{Binding FalseCallRate}" Width="105"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Factory Readiness" ToolTip="Shows what evidence is present, what is missing, and why it matters. Acceptance rows are evidence checks, not final certification.">
            <DataGrid x:Name="FactoryReadinessGrid" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                <DataGridTextColumn Header="Next Action" Binding="{Binding NextAction}" Width="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Standards &amp; Quality Checklist" ToolTip="Maps project HMI/software-quality expectations to concrete evidence. This is standards-aligned evidence, not certification.">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <Button Style="{StaticResource ActionBtnBlue}" Content="Refresh Checklist" Margin="0,0,6,0" Click="OnRefreshStandardsTraceabilityClick"/>
                  <Button Style="{StaticResource ActionBtnAmber}" Content="Export HTML/PDF/JSON" Click="OnExportStandardsTraceabilityClick"/>
                </WrapPanel>
                <TextBlock x:Name="StandardsTraceabilitySummaryText"
                           Text="Standards traceability not loaded."
                           Foreground="#DCE5EB"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
              </DockPanel>
              <DataGrid x:Name="StandardsTraceabilityGrid" Grid.Row="1" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="Long evidence paths and notes are available through hover when truncated.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Source" Binding="{Binding StandardOrSource}" Width="170"/>
                  <DataGridTextColumn Header="Requirement / Principle" Binding="{Binding PrincipleOrRequirement}" Width="260"/>
                  <DataGridTextColumn Header="ID" Binding="{Binding ProjectRequirementId}" Width="95"/>
                  <DataGridTextColumn Header="Evidence Type" Binding="{Binding EvidenceType}" Width="155"/>
                  <DataGridTextColumn Header="Evidence Path" Binding="{Binding EvidencePath}" Width="240"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                  <DataGridTextColumn Header="Blocking" Binding="{Binding BlockingLevel}" Width="115"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="Evidence Completion" ToolTip="Shows missing evidence by stage. Completion is not the same as production release approval.">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="8">
                <Button Style="{StaticResource ActionBtnBlue}" Content="Refresh Evidence List" Click="OnRefreshCompletionMatrixClick"/>
                <TextBlock x:Name="CompletionMatrixSummaryText" Text="Evidence list not loaded." Foreground="#DCE5EB" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
              </StackPanel>
              <DataGrid x:Name="CompletionMatrixGrid" Grid.Row="1" CanUserSortColumns="True" Style="{StaticResource HmiTable}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="210"/>
                  <DataGridTextColumn Header="Complete" Binding="{Binding PercentDisplay}" Width="90"/>
                  <DataGridTextColumn Header="Evidence Score" Binding="{Binding EvidenceSummary}" Width="300"/>
                  <DataGridTextColumn Header="What Is Missing" Binding="{Binding MissingEvidenceDisplay}" Width="*"/>
                  <DataGridTextColumn Header="What To Do Next" Binding="{Binding NextActionsDisplay}" Width="320"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="Factory Acceptance" ToolTip="Factory acceptance checklist for evidence collection and signoff. Do not overclaim production readiness from a single checklist row.">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock Text="Deployment Profile" Foreground="#9AA6AF" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="FactoryAcceptanceProfileCombo" Width="230" SelectedIndex="0" Style="{StaticResource FilterCombo}"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Generate Checklist" Margin="8,0,0,0" Click="OnGenerateFactoryAcceptanceChecklistClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Export FAT Package" Margin="8,0,0,0" Click="OnExportFactoryAcceptanceChecklistClick"/>
              </StackPanel>
              <DataGrid x:Name="FactoryAcceptanceGrid" Grid.Row="1" CanUserSortColumns="True" Style="{StaticResource HmiTable}" ToolTip="Evidence paths and notes may be long; hover cells to inspect full values.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding RequirementId}" Width="95"/>
                  <DataGridTextColumn Header="Requirement" Binding="{Binding RequirementText}" Width="220"/>
                  <DataGridTextColumn Header="Required Evidence" Binding="{Binding RequiredEvidence}" Width="240"/>
                  <DataGridTextColumn Header="Evidence Path" Binding="{Binding CurrentEvidencePath}" Width="190"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                  <DataGridTextColumn Header="Signoff Role" Binding="{Binding SignoffRole}" Width="105"/>
                  <DataGridTextColumn Header="Signed By" Binding="{Binding SignedBy}" Width="105"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Panel}">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Auto-Archive Policy" Foreground="#9AA6AF" FontSize="14" Margin="0,0,0,3"/>
          <TextBlock x:Name="ArchivePolicyText"
                     Text="Logs older than 30 days are copied into LogArchive during startup. Source rows remain in place, so the archive is reversible and audit-safe."
                     TextWrapping="Wrap" FontSize="14" Foreground="#DCE5EB"/>
          <TextBlock x:Name="StatusText" Text="Ready." Foreground="#9AA6AF" FontSize="14" Margin="0,6,0,0"/>
          <TextBlock x:Name="PackagePathText" Text="Latest customer package: --" Foreground="#DCE5EB" FontSize="14" Margin="0,3,0,0" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
          <TextBlock x:Name="SoakReportPathText" Text="Latest soak-test report: --" Foreground="#DCE5EB" FontSize="14" Margin="0,3,0,0" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
          <TextBlock x:Name="BuildEvidenceSummaryText" Text="Build/test evidence: --" Foreground="#DCE5EB" FontSize="14" Margin="0,3,0,0" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/>
          <TextBlock x:Name="ClientDemoGateText" Text="Client demo readiness: not evaluated" Foreground="#E1A334" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ProgressBar x:Name="WorkProgressBar" Width="190" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelWorkButton" Style="{StaticResource MiniBtn}" Content="Cancel" IsEnabled="False" Click="OnCancelWorkClick"/>
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250">
        <StackPanel>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Evidence Exports" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Inspection History CSV" Margin="0,0,6,6" Click="OnExportInspectionHistoryClick"/>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Review Log CSV" Margin="0,0,6,6" Click="OnExportReviewLogClick"/>
                <Button Style="{StaticResource ActionBtnGreen}" Content="Audit Trail CSV" Margin="0,0,6,6" Click="OnExportAuditTrailClick"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Annotated Overlays" Margin="0,0,6,6" Click="OnExportAnnotatedOverlaysClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Verify Selected Export" Margin="0,0,6,6" Click="OnVerifySelectedExportClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Readiness and Quality Gates" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Create Stage 1 Customer Package" Margin="0,0,6,6" Click="OnExportCustomerPackageClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Export Readiness Evidence" Margin="0,0,6,6" Click="OnExportFactoryReadinessPackageClick" ToolTip="Exports the readiness evidence package. This is not final production certification."/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Client Demo Readiness" Margin="0,0,6,6" Click="OnClientDemoReadinessClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Demo Gate" Margin="0,0,6,6" Click="OnExportClientDemoReadinessClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Export Standards Matrix" Margin="0,0,6,6" Click="OnExportStandardsTraceabilityClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Export FAT Checklist" Margin="0,0,6,6" Click="OnExportFactoryAcceptanceChecklistClick"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Import Build/Test Evidence" Margin="0,0,6,6" Click="OnImportBuildTestEvidenceClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Open Build Evidence Folder" Margin="0,0,6,6" Click="OnOpenBuildEvidenceFolderClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Soak Test" Margin="0,0,6,6" Click="OnRunSoakTestClick"/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Performance Benchmark" Margin="0,0,6,6" Click="OnRunPerformanceBenchmarkClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Latest Soak Evidence" Margin="0,0,6,6" Click="OnExportLatestSoakEvidenceClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Database and Image Index" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtn}" Content="DB Integrity" Margin="0,0,6,6" Click="OnRunDbIntegrityCheckClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Database Health" Margin="0,0,6,6" Click="OnOpenDatabaseHealthClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Verify Paths" Margin="0,0,6,6" Click="OnVerifyImagePathsClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Rebuild Image Index" Margin="0,0,6,6" Click="OnRebuildImageIndexClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Lock Recipe" Margin="0,0,6,6" Click="OnLockActiveRecipeClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="MES Traceability Queue" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Send Result to Traceability System" Margin="0,0,6,6" Click="OnUploadMesMockClick" ToolTip="MES means factory traceability system. Mock mode creates local evidence only."/>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Run Traceability Test" Margin="0,0,6,6" Click="OnRunTraceabilityTestClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected Upload" Margin="0,0,6,6" Click="OnRetrySelectedMesSpoolClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Waiting Uploads" Margin="0,0,6,6" Click="OnRetryMesSpoolClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Queue Report" Margin="0,0,6,6" Click="OnExportMesQueueReportClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export MES Contract" Margin="0,0,6,6" Click="OnExportMesContractClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Mark MES Abandoned" Margin="0,0,6,6" Click="OnAbandonMesSpoolClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="Central Evidence Sync" Style="{StaticResource HmiSectionHeaderText}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Central Sync" Margin="0,0,6,6" Click="OnQueueCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry Selected Central" Margin="0,0,6,6" Click="OnRetrySelectedCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtnAmber}" Content="Retry All Central" Margin="0,0,6,6" Click="OnRetryCentralSyncClick"/>
                <Button Style="{StaticResource ActionBtn}" Content="Export Central Sync Report" Margin="0,0,6,6" Click="OnExportCentralSyncReportClick"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>

