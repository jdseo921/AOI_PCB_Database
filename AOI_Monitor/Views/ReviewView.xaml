<UserControl x:Class="AOI_Monitor.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HmiBgBrush}"
             PreviewKeyDown="OnReviewPreviewKeyDown">
  <UserControl.Resources>
    <Style x:Key="RiskChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Escape">
          <Setter Property="Background" Value="#35191B"/>
          <Setter Property="BorderBrush" Value="#9A393E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Background" Value="#372914"/>
          <Setter Property="BorderBrush" Value="#8C6C35"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Background" Value="#172A39"/>
          <Setter Property="BorderBrush" Value="#477CA5"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiskChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HmiTextBodyBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="Escape">
          <Setter Property="Foreground" Value="{DynamicResource HmiNgSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="False Call">
          <Setter Property="Foreground" Value="{DynamicResource HmiWarnSoftBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="Verified NG">
          <Setter Property="Foreground" Value="{DynamicResource HmiInfoSoftBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource FactoryScrollablePage}">
  <Grid Margin="8" MinHeight="665">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="372"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="340"/>
    </Grid.ColumnDefinitions>

    <!-- Left: Queue + Similar -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Queue -->
      <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
                <TextBlock Text="Demo Data" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="14"/>
              </Border>
              <TextBlock Text="Prioritized Review Queue" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
            </DockPanel>
          </Border>
          <DataGrid Grid.Row="1"
                    x:Name="QueueGrid"
                    BorderThickness="0"
                    Margin="0"
                    MinWidth="0"
                    MaxHeight="480"
                    Style="{StaticResource HmiDenseTable}"
                    ToolTip="AI means inspection result. GT means ground truth. RefDes means reference designator.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#"      Binding="{Binding Priority}"    Width="38" MinWidth="38"/>
                <DataGridTextColumn Header="Sample" Binding="{Binding Sample}"      Width="104" MinWidth="104"/>
                <DataGridTextColumn Header="AI"     Binding="{Binding AiResult}"    Width="54" MinWidth="54" HeaderTemplate="{StaticResource HmiHeaderInspectionResultTemplate}"/>
                <DataGridTextColumn Header="GT"     Binding="{Binding GroundTruth}" Width="54" MinWidth="54" HeaderTemplate="{StaticResource HmiHeaderGroundTruthTemplate}"/>
                <DataGridTemplateColumn Header="Risk" Width="*" MinWidth="118">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource RiskChipBorder}" HorizontalAlignment="Left" Margin="0,1,0,1">
                        <TextBlock Text="{Binding Risk}" Style="{StaticResource RiskChipText}"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
        </Grid>
      </Border>

      <!-- Similar images -->
      <Border Grid.Row="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
                <TextBlock Text="Demo Data" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="14"/>
              </Border>
              <TextBlock Text="Closest Matching Defect Images" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
              <TextBlock Text="Default: closest known false-negative cases first"
                         Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="14" Margin="0,0,0,4"/>
              <!-- Sim card 1 -->
              <Border Background="#141A1E" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Padding="6" Margin="{StaticResource HmiRowGap}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#183D22" BorderBrush="#52605A" BorderThickness="1" MinHeight="56">
                    <Rectangle Width="20" Height="14" Stroke="#F13B3F" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="IMG_0114 / 96%" FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
                    <TextBlock Text="Solder Bridge" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" Margin="0,2,0,0"/>
                    <TextBlock Text="RefDes: U107" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" Margin="0,2,0,0"/>
                    <Border Style="{StaticResource ChipRed}" HorizontalAlignment="Left">
                      <TextBlock Text="False Negative History" Foreground="{DynamicResource HmiNgSoftBrush}" FontSize="14" FontWeight="Bold"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- Sim card 2 -->
              <Border Background="#141A1E" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="1" Padding="6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#183D22" BorderBrush="#52605A" BorderThickness="1" MinHeight="56">
                    <Rectangle Width="20" Height="14" Stroke="#F13B3F" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="IMG_0088 / 92%" FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
                    <TextBlock Text="Solder Bridge" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" Margin="0,2,0,0"/>
                    <TextBlock Text="RefDes: U109" Foreground="{DynamicResource HmiMutedTextBrush}" FontSize="14" Margin="0,2,0,0"/>
                    <Border Style="{StaticResource ChipRed}" HorizontalAlignment="Left">
                      <TextBlock Text="False Negative History" Foreground="{DynamicResource HmiNgSoftBrush}" FontSize="14" FontWeight="Bold"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Center: PCB image stage -->
    <Border Grid.Column="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="32"/>
          <RowDefinition Height="Auto" MinHeight="46"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
              <TextBlock Text="Demo Board Illustration" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="14"/>
            </Border>
            <TextBlock Text="Current Sample Image" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
          </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource HmiSurfaceBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource MiniBtn}" Content="Overlay: AI+GT" Margin="{StaticResource HmiButtonGap}" Click="OnOverlayClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Zoom 125%" Margin="{StaticResource HmiButtonGap}" Click="OnZoomClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="Golden Compare" Margin="{StaticResource HmiButtonGap}" Click="OnGoldenCompareClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="ROI Crop" Margin="{StaticResource HmiButtonGap}" Click="OnRoiCropClick"/>
            <Button Style="{StaticResource MiniBtn}" Content="History" Click="OnHistoryClick"/>
          </StackPanel>
        </Border>

        <!-- PCB Canvas -->
        <Border Grid.Row="2" Margin="8" MaxHeight="560" BorderBrush="{DynamicResource HmiBorderMidBrush}" BorderThickness="1" Background="{DynamicResource HmiSurfaceBrush}" ClipToBounds="True">
          <Viewbox x:Name="ReviewCanvasViewbox" Stretch="Uniform">
          <Viewbox.LayoutTransform>
            <ScaleTransform x:Name="ReviewZoomTransform" ScaleX="1" ScaleY="1"/>
          </Viewbox.LayoutTransform>
          <Canvas Width="500" Height="380">
            <!-- PCB Board (green, grid) -->
            <Border Canvas.Left="55" Canvas.Top="32" Width="390" Height="260"
                    BorderBrush="#5A8C59" BorderThickness="2">
              <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,34,34" ViewportUnits="Absolute" Stretch="None">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <GeometryDrawing Brush="#164321"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,34,34"/></GeometryDrawing.Geometry></GeometryDrawing>
                      <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#1B5A28" Thickness="1"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="33.5,0" EndPoint="33.5,34"/><LineGeometry StartPoint="0,33.5" EndPoint="34,33.5"/></GeometryGroup></GeometryDrawing.Geometry>
                      </GeometryDrawing>
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.Background>
            </Border>

            <!-- Components on the board (positions relative to canvas, board at 55,32) -->
            <!-- U101: board 12%=47, 18%=47 of 390x260 → canvas 102,79 -->
            <Border Canvas.Left="102" Canvas.Top="79" Width="120" Height="70"
                    Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1">
              <TextBlock Text="U101" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource HmiTextBodyBrush}"/>
            </Border>
            <!-- CN8: right 15%→canvas 295,79 -->
            <Border Canvas.Left="295" Canvas.Top="79" Width="92" Height="58"
                    Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1">
              <TextBlock Text="CN8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource HmiTextBodyBrush}"/>
            </Border>
            <!-- U107 (center, has defect): board left 32%=125 top 42%=109 → canvas 180,141 -->
            <Border Canvas.Left="180" Canvas.Top="141" Width="168" Height="82"
                    Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1">
              <TextBlock Text="U107" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource HmiTextBodyBrush}"/>
            </Border>
            <!-- SH1 -->
            <Border Canvas.Left="238" Canvas.Top="178" Width="142" Height="64"
                    Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1">
              <TextBlock Text="SH1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource HmiTextBodyBrush}"/>
            </Border>
            <!-- D12 -->
            <Border Canvas.Left="110" Canvas.Top="183" Width="88" Height="52"
                    Background="{DynamicResource HmiRaisedBrush}" BorderBrush="{DynamicResource HmiBorderStrongBrush}" BorderThickness="1">
              <TextBlock Text="D12" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource HmiTextBodyBrush}"/>
            </Border>

            <!-- ROI box (dashed amber) around U107 area -->
            <Rectangle Canvas.Left="168" Canvas.Top="132" Width="202" Height="108"
                       Stroke="#E1A334" StrokeThickness="1.5" Fill="Transparent"
                       StrokeDashArray="4 3"/>

            <!-- Defect box (red) on U107 -->
            <Canvas Canvas.Left="248" Canvas.Top="152" Width="62" Height="44">
              <Rectangle Width="62" Height="44" Stroke="#F13B3F" StrokeThickness="2" Fill="Transparent"
                         Effect="{x:Null}"/>
              <Border Canvas.Left="-2" Canvas.Top="-20" Background="#F13B3F" Padding="5,2">
                <TextBlock Text="U107 BRIDGE" Foreground="White" FontSize="14" FontWeight="ExtraBold"/>
              </Border>
            </Canvas>

            <!-- Crosshairs -->
            <Line X1="0" Y1="173" X2="500" Y2="173" Stroke="#3C6480" StrokeThickness="1" Opacity="0.6"/>
            <Line X1="290" Y1="0" X2="290" Y2="380" Stroke="#3C6480" StrokeThickness="1" Opacity="0.6"/>
          </Canvas>
          </Viewbox>
        </Border>

        <!-- Image footer: metadata fields -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="8" Rows="1">
          <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel>
              <TextBlock Text="Sample ID"   Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="IMG_0241"    FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel>
              <TextBlock Text="Board"       Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="TBOX-MAIN"   FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiButtonGap}">
            <StackPanel>
              <TextBlock Text="RefDes"      Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="U107"        FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="FOV"         Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="TOP-03"      FontWeight="Bold" Foreground="{DynamicResource HmiTextBrush}" FontSize="14"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </Border>

    <!-- Right: Metadata + Decision -->
    <Grid Grid.Column="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Metadata -->
      <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource ChipPurple}" Padding="6,1">
                <TextBlock Text="Demo Metadata" Foreground="{DynamicResource HmiSimulatedSoftBrush}" FontWeight="Bold" FontSize="14"/>
              </Border>
              <TextBlock Text="Sample Metadata" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <UniformGrid Columns="2" Margin="8" Rows="4">
            <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiFieldGap}">
              <StackPanel><TextBlock Text="Sample ID" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="IMG_0241" FontWeight="Bold" FontSize="14" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
              <StackPanel><TextBlock Text="Board" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="TBOX-MAIN" FontWeight="Bold" FontSize="14" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiFieldGap}">
              <StackPanel><TextBlock Text="RefDes" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="U107" FontWeight="Bold" FontSize="14"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
              <StackPanel><TextBlock Text="FOV" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="TOP-03" FontWeight="Bold" FontSize="14"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="{StaticResource HmiFieldGap}">
              <StackPanel><TextBlock Text="Inspection Result" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="OK" FontWeight="Bold" FontSize="14"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
              <StackPanel><TextBlock Text="Ground Truth" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="NG" FontWeight="Bold" Foreground="{DynamicResource HmiNgStrongBrush}" FontSize="14"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="Risk" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="Possible Escape" FontWeight="Bold" Foreground="{DynamicResource HmiNgStrongBrush}" FontSize="14"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FieldBox}" Margin="0">
              <StackPanel><TextBlock Text="Engine" Foreground="{DynamicResource HmiTextDimBrush}" FontSize="14" Margin="0,0,0,2"/>
              <TextBlock Text="Pixel Difference Prototype Engine 0.1" FontWeight="Bold" FontSize="14" Style="{StaticResource FactoryTrimmedTextWithTooltip}"/></StackPanel>
            </Border>
          </UniformGrid>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Disposition controls -->
      <Border Grid.Row="2" Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HmiSurfaceAltBrush}" BorderBrush="{DynamicResource HmiPanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Disposition Controls" Foreground="{DynamicResource HmiTextBodyBrush}" FontWeight="ExtraBold" FontSize="14"/>
          </Border>
          <StackPanel Grid.Row="1" Margin="8">
            <TextBlock Text="Keyboard: 1 Confirm NG · 2 False Call · 3 Possible Escape · 4 Hold" Foreground="{DynamicResource HmiTextLabelBrush}" FontSize="14" TextWrapping="Wrap" Margin="{StaticResource HmiRowGap}"/>
            <Button Style="{StaticResource ActionBtnRed}" Content="Confirm NG (1)" Margin="{StaticResource HmiRowGap}" Click="OnConfirmNgClick"/>
            <Button Style="{StaticResource ActionBtnAmber}" Content="Mark False Call (2)" Margin="{StaticResource HmiRowGap}" Click="OnFalseCallClick"/>
            <Button Style="{StaticResource ActionBtnRed}" Content="Mark Possible Escape (3)" Margin="{StaticResource HmiRowGap}" Click="OnPossibleEscapeClick"/>
            <Button Style="{StaticResource ActionBtnBlue}" Content="Queue Candidate" Margin="{StaticResource HmiRowGap}" Click="OnSendTrainingClick"/>
            <Button Style="{StaticResource ActionBtn}" Content="Hold for 2nd Review (4)" Click="OnHoldClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
  </ScrollViewer>
</UserControl>

