<UserControl x:Class="AOI_Monitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0E10">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Settings form -->
    <Border Grid.Column="0" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Display / Language" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="12">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Language" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="LangCombo" SelectedIndex="0">
              <ComboBoxItem>English</ComboBoxItem>
              <ComboBoxItem>Korean</ComboBoxItem>
            </ComboBox>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Font Size" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="FontCombo" SelectedIndex="1">
              <ComboBoxItem>Compact</ComboBoxItem>
              <ComboBoxItem>Standard</ComboBoxItem>
              <ComboBoxItem>Large</ComboBoxItem>
            </ComboBox>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Storage Path" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="D:/AOI_DB/TBOX_MAIN/image_vault/"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Review Default" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="ReviewDefaultText" Grid.Column="1" Style="{StaticResource ReadonlyInput}" Text="Minimize False Positives"/>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Detection Priority" Foreground="#9AA6AF" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox x:Name="DetectionPriorityCombo" Grid.Column="1" SelectedIndex="0">
              <ComboBoxItem Content="Minimize False Positives"/>
              <ComboBoxItem Content="Balanced"/>
              <ComboBoxItem Content="Maximize Defect Recall"/>
            </ComboBox>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource ActionBtnGreen}" Content="Apply" Click="OnApply" Margin="0,0,8,0"/>
            <Button Style="{StaticResource ActionBtn}"      Content="Reset" Click="OnReset"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Training + Notes -->
    <Border Grid.Column="2" Style="{StaticResource Panel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="25"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1A2024" BorderBrush="#343D44" BorderThickness="0,0,0,1" Padding="8,4">
          <TextBlock Text="Training / Policy Management" Foreground="#DCE5EB" FontWeight="ExtraBold" FontSize="11.5"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="8">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Training Session" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button Style="{StaticResource MiniBtnGreen}" Content="Start" Margin="0,0,6,6" Click="OnStartTrainingClick"/>
                <Button Style="{StaticResource MiniBtn}" Content="Run Epoch" Margin="0,0,6,6" Click="OnRunEpochClick"/>
                <Button Style="{StaticResource MiniBtnAmber}" Content="Stop" Margin="0,0,6,6" Click="OnStopTrainingClick"/>
                <Button Style="{StaticResource MiniBtn}" Content="Open Folder" Margin="0,0,0,6" Click="OnOpenTrainingFolderClick"/>
              </WrapPanel>
              <UniformGrid Columns="2" Margin="0,4,0,0">
                <TextBlock Text="Status" Foreground="#9AA6AF" FontSize="11"/>
                <TextBlock x:Name="TrainingStatusText" Text="IDLE" FontWeight="Bold" FontSize="11.5" Foreground="#DCE5EB" HorizontalAlignment="Right"/>
                <TextBlock Text="Queued samples" Foreground="#9AA6AF" FontSize="11"/>
                <TextBlock x:Name="TrainingQueueText" Text="0" FontWeight="Bold" FontSize="11.5" Foreground="#DCE5EB" HorizontalAlignment="Right"/>
                <TextBlock Text="Epochs completed" Foreground="#9AA6AF" FontSize="11"/>
                <TextBlock x:Name="TrainingEpochText" Text="0" FontWeight="Bold" FontSize="11.5" Foreground="#DCE5EB" HorizontalAlignment="Right"/>
                <TextBlock Text="Last validation" Foreground="#9AA6AF" FontSize="11"/>
                <TextBlock x:Name="TrainingValidationText" Text="--" FontWeight="Bold" FontSize="11.5" Foreground="#DCE5EB" HorizontalAlignment="Right"/>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="8,0,8,8">
          <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Localization" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap" LineHeight="18" FontSize="11.5"
                Text="All workstation labels are switched at runtime. Technical codes remain unchanged for traceability."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource FieldBox}">
            <StackPanel>
              <TextBlock Text="Configuration Policy" Foreground="#7F8C95" FontSize="10" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap" LineHeight="18" FontSize="11.5"
                Text="Training controls let users initiate and manage fine-tuning sessions while selecting detector behavior priorities. Default mode minimizes false positives for stable deployment."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
