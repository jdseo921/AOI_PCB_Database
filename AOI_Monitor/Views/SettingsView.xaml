                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="#9AA6AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite"
